[Unit]
Description=Reset the ssupt.audio-control backend if it stops answering
Documentation=https://github.com/ssupt/omarchy-audio-control
# After uninstall the unit files can outlive the script for one reload cycle;
# skip cleanly instead of showing a failed unit.
ConditionPathExists=%h/.local/bin/audio-backend-watchdog.sh

[Service]
Type=oneshot
ExecStart=%h/.local/bin/audio-backend-watchdog.sh
# Short: the healthy path is one round-trip to a unix socket.
TimeoutStartSec=45
