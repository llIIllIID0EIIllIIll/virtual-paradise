# Virtual☆Paradise Micro Colorscheme
# Cyberpunk Neon Rice Palette (Cyan #00f5d4, Green #00ff88, Sakura Pink #ffb7d5, Dark #0d1117/#131920)

color-link default "#eafbfa,#0d1117"
color-link comment "#7091a4"
color-link comment.bright "#8daab9"
color-link constant "#ffb7d5"
color-link constant.bool "#00ff88"
color-link constant.bool.true "#00ff88"
color-link constant.bool.false "#ff0055"
color-link constant.number "#ff94c2"
color-link constant.specialChar "#00f5d4"
color-link constant.string "#00ff88"
color-link constant.string.url "underline #00f5d4"
color-link statement "bold #ff54a2"
color-link symbol "#00f5d4"
color-link symbol.operator "#ffb7d5"
color-link symbol.brackets "#00f5d4"
color-link symbol.tag "bold #00f5d4"
color-link preproc "#00ff88"
color-link type "bold #00f5d4"
color-link type.keyword "bold #00f5d4"
color-link special "#ffb7d5"
color-link underlined "underline #00f5d4"
color-link error "bold #ff0055"
color-link todo "bold #ffb7d5"
color-link hlsearch "#131920,#00ff88"
color-link statusline "#eafbfa,#131920"
color-link tabbar "#7091a4,#131920"
color-link indent-char "#253341"
color-link line-number "#7091a4,#0d1117"
color-link current-line-number "bold #00f5d4,#131920"
color-link gutter-error "#ff0055"
color-link gutter-warning "#ffb7d5"
color-link cursor-line "#131920"
color-link color-column "#131920"
color-link divider "#00f5d4,#131920"
color-link message "#00f5d4"
color-link error-message "bold #ff0055"
