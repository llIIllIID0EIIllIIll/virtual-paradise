# Virtual☆Paradise Micro Colorscheme
# Cyberpunk Neon Rice Palette (Cyan #00ffdd, Green #00ff88, Sakura Pink #ffb7d5, Dark #0f081d/#180e2e)

color-link default "#eafbfa,#0f081d"
color-link comment "#9684c0"
color-link comment.bright "#c5e8ea"
color-link constant "#ffb7d5"
color-link constant.bool "#00ff88"
color-link constant.bool.true "#00ff88"
color-link constant.bool.false "#ff0055"
color-link constant.number "#ffd6e7"
color-link constant.specialChar "#00ffdd"
color-link constant.string "#00ff88"
color-link constant.string.url "underline #00ffdd"
color-link statement "bold #ff79a8"
color-link symbol "#00ffdd"
color-link symbol.operator "#ffb7d5"
color-link symbol.brackets "#00ffdd"
color-link symbol.tag "bold #00ffdd"
color-link preproc "#00ff88"
color-link type "bold #00ffdd"
color-link type.keyword "bold #00ffdd"
color-link special "#ffb7d5"
color-link underlined "underline #00ffdd"
color-link error "bold #ff0055"
color-link todo "bold #ffb7d5"
color-link hlsearch "#180e2e,#00ff88"
color-link statusline "#eafbfa,#180e2e"
color-link tabbar "#9684c0,#180e2e"
color-link indent-char "#3b255c"
color-link line-number "#9684c0,#0f081d"
color-link current-line-number "bold #00ffdd,#180e2e"
color-link gutter-error "#ff0055"
color-link gutter-warning "#ffb7d5"
color-link cursor-line "#180e2e"
color-link color-column "#180e2e"
color-link divider "#00ffdd,#180e2e"
color-link message "#00ffdd"
color-link error-message "bold #ff0055"
