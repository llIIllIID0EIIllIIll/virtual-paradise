#!/bin/bash
# ==============================================================================
#  momoisay — Theme-Aware Mascot Wrapper
#  Automatically matches ASCII Momoi's color to the active Omarchy theme
# ==============================================================================

REAL_BIN=""
if [[ -x "$HOME/.local/bin/momoisay.real" ]]; then
  REAL_BIN="$HOME/.local/bin/momoisay.real"
elif [[ -x "$(dirname "$0")/momoisay.real" ]]; then
  REAL_BIN="$(dirname "$0")/momoisay.real"
elif [[ -x "/usr/local/bin/momoisay.real" ]]; then
  REAL_BIN="/usr/local/bin/momoisay.real"
elif [[ -x "/usr/local/bin/momoisay" ]]; then
  REAL_BIN="/usr/local/bin/momoisay"
fi

if [[ -z "$REAL_BIN" ]]; then
  echo "Error: momoisay binary not found." >&2
  exit 1
fi

# If user explicitly passed -c or --color, respect user's flag directly
for arg in "$@"; do
  if [[ "$arg" == "-c" || "$arg" == "--color" ]]; then
    exec "$REAL_BIN" "$@"
  fi
done

# Detect active theme name
THEME_NAME=""
if [[ -f "$HOME/.local/state/omarchy/current/theme.name" ]]; then
  THEME_NAME="$(<"$HOME/.local/state/omarchy/current/theme.name")"
fi

# Map active theme to best matching Momoi color (red green yellow blue magenta cyan white)
COLOR="cyan"
case "$THEME_NAME" in
  virtual-paradise)
    COLOR="cyan"
    ;;
  catppuccin|tokyo-night|nord|dracula)
    COLOR="blue"
    ;;
  everforest|gruvbox|solarized-dark|solarized-light)
    COLOR="green"
    ;;
  rose-pine)
    COLOR="magenta"
    ;;
  kanagawa|catppuccin-latte)
    COLOR="yellow"
    ;;
  *)
    # Check accent color in colors.toml
    COLORS_FILE="$HOME/.local/state/omarchy/current/theme/colors.toml"
    if [[ -f "$COLORS_FILE" ]]; then
      ACCENT=$(grep -E '^\s*accent\s*=' "$COLORS_FILE" | head -1 | sed -E 's/.*"([^"]+)".*/\1/')
      case "$ACCENT" in
        *00f5d4*|*cyan*) COLOR="cyan" ;;
        *blue*|*89b4fa*|*7aa2f7*|*81a1c1*) COLOR="blue" ;;
        *green*|*a6e3a1*|*a7c080*|*b8bb26*|*73daca*) COLOR="green" ;;
        *magenta*|*f5c2e7*|*ebbcba*|*bb9af7*|*d699b6*) COLOR="magenta" ;;
        *yellow*|*ffe066*|*f9e2af*|*e5c07b*) COLOR="yellow" ;;
        *red*|*ff5287*|*f38ba8*|*ff0055*) COLOR="red" ;;
        *) COLOR="white" ;;
      esac
    fi
    ;;
esac

exec "$REAL_BIN" -c "$COLOR" "$@"
