#!/bin/bash
# ==============================================================================
#  Virtual☆Paradise — Animated Logout with Miku Outro Splash
# ==============================================================================

# Launch Miku outro animated splash in background
if command -v quickshell &>/dev/null && [[ -f "$HOME/.local/bin/logout_splash.qml" ]]; then
  SPLASH_TEXT="󰍃 Logging out session..." quickshell -p "$HOME/.local/bin/logout_splash.qml" >/dev/null 2>&1 &
fi

nohup bash -c "sleep 2.5 && uwsm stop" >/dev/null 2>&1 &

omarchy-osd -i logout -m "Logging out" -d 5000 2>/dev/null || true

# Close windows cleanly while splash is visible
omarchy-hyprland-window-close-all 2>/dev/null || true
sleep 2.2
