#!/bin/bash
# ==============================================================================
#  Virtual☆Paradise — Seamless Fullscreen Outro Logout with Curtain Transition
# ==============================================================================

# 1. Launch curtain transition on overlay layer (closes from 2 halves inward)
if command -v quickshell &>/dev/null && [[ -f "$HOME/.local/bin/curtain_transition.qml" ]]; then
  CURTAIN_LAYER="overlay" quickshell -p "$HOME/.local/bin/curtain_transition.qml" >/dev/null 2>&1 &
fi

# 2. Wait until curtains are fully closed covering the screen (400ms)
sleep 0.40

# 3. Behind closed curtains: close windows & launch Miku outro splash
omarchy-hyprland-window-close-all 2>/dev/null || true

if command -v quickshell &>/dev/null && [[ -f "$HOME/.local/bin/logout_splash.qml" ]]; then
  SPLASH_TEXT="󰍃 Logging out session..." quickshell -p "$HOME/.local/bin/logout_splash.qml" >/dev/null 2>&1 &
fi

# 4. Outro plays until SDDM takes over
sleep 2.0
uwsm stop
