#!/bin/bash
# ==============================================================================
#  Virtual☆Paradise — Seamless Outro Reboot with Curtain Transition
# ==============================================================================

# 1. Launch Cyberpunk glitch transition on overlay layer
if command -v quickshell &>/dev/null && [[ -f "$HOME/.local/bin/curtain_transition.qml" ]]; then
  CURTAIN_LAYER="overlay" quickshell -p "$HOME/.local/bin/curtain_transition.qml" >/dev/null 2>&1 &
fi

# 2. Wait until Glitch.jpg is 100% solid covering the screen (180ms)
sleep 0.18

# 3. Behind closed curtains: close windows & launch Miku outro splash
omarchy-state clear re*-required 2>/dev/null || true
omarchy-hyprland-window-close-all 2>/dev/null || true

if command -v quickshell &>/dev/null && [[ -f "$HOME/.local/bin/logout_splash.qml" ]]; then
  SPLASH_TEXT="󰜉 Rebooting system..." quickshell -p "$HOME/.local/bin/logout_splash.qml" >/dev/null 2>&1 &
fi

# 4. Curtains open to reveal Miku outro; play smoothly for 3.5s before handover
sleep 3.5

# 5. Hand over to systemd reboot — Plymouth starts concurrently without waiting for SDDM
systemctl reboot --no-wall
