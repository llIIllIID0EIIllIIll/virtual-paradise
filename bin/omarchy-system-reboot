#!/bin/bash
# ==============================================================================
#  Virtual☆Paradise — Seamless Outro Reboot
# ==============================================================================

# Launch Miku outro animated splash in background
if command -v quickshell &>/dev/null && [[ -f "$HOME/.local/bin/logout_splash.qml" ]]; then
  SPLASH_TEXT="󰜉 Rebooting system..." quickshell -p "$HOME/.local/bin/logout_splash.qml" >/dev/null 2>&1 &
fi

# Wait for splash window to map
sleep 0.25

omarchy-state clear re*-required 2>/dev/null || true
omarchy-hyprland-window-close-all 2>/dev/null || true

# Play outro animation smoothly before handover
sleep 3.5

# Hand over to systemd reboot — Plymouth starts concurrently without waiting for SDDM
systemctl reboot --no-wall
