#!/bin/bash
# ==============================================================================
#  Virtual☆Paradise — Seamless Fullscreen Outro Shutdown
# ==============================================================================

# Launch Miku outro animated splash in background (plays continuously until screen powers off)
if command -v quickshell &>/dev/null && [[ -f "$HOME/.local/bin/logout_splash.qml" ]]; then
  SPLASH_TEXT="󰐥 Shutting down system..." quickshell -p "$HOME/.local/bin/logout_splash.qml" >/dev/null 2>&1 &
fi

omarchy-state clear re*-required 2>/dev/null || true
omarchy-hyprland-window-close-all 2>/dev/null || true

# Hand over to systemd poweroff - splash remains active until Plymouth takes over
systemctl poweroff --no-wall
