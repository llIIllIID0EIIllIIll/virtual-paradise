{
  "bar": {
    "centerAnchor": "__USER__.clock",
    "layout": {
      "center": [
        {
          "id": "io.github.erikburdett.wavebar"
        },
        {
          "id": "__USER__.weather"
        },
        {
          "id": "__USER__.clock",
          "format": "d MMMM 'W'ww yyyy",
          "formatAlt": "yyyy-MM-dd HH:mm:ss",
          "verticalFormat": "HH\n—\nmm",
          "worldZones": [
            "Asia/Tokyo",
            "Europe/London",
            "America/New_York"
          ]
        },
        {
          "id": "io.github.woogy7.vitals"
        },
        {
          "id": "__USER__.cputemp"
        },
        {
          "id": "__USER__.microphone"
        },
        {
          "alwaysShow": false,
          "id": "__USER__.indicators",
          "items": [
            "Dictation",
            "PasswordlessSudo",
            "ScreenRecording",
            "RemoteSession",
            "Reminder",
            "NightLight",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.keyboard-layout"
        }
      ],
      "left": [
        {
          "id": "__USER__.menu"
        },
        {
          "id": "io.github.tyrichards.workspaces-jap"
        },
        {
          "id": "__USER__.active-window",
          "maxWidth": 180
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "__USER__.network"
        },
        {
          "id": "ssupt.audio-control"
        },
        {
          "id": "onlyvishesh.power-manager",
          "showPercentage": true
        },
        {
          "id": "__USER__.system-update"
        },
        {
          "id": "__USER__.tools"
        },
        {
          "id": "io.github.randazraik.xray",
          "hidden": true
        },
        {
          "id": "io.github.grichard99.omaproton-vpn",
          "hidden": true
        },
        {
          "id": "io.github.kristoferlund.webcam",
          "hidden": true
        },
        {
          "id": "crmne.hyprmoncfg",
          "hidden": true
        },
        {
          "id": "io.github.jeffcortez23.omarchy-projector-cast",
          "hidden": true
        },
        {
          "id": "ssupt.bluetooth-audio",
          "hidden": true
        }
      ]
    },
    "position": "top",
    "transparent": true,
    "id": "__USER__.island-bar"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "__USER__.lock"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "__USER__.lock"
  ]
}
