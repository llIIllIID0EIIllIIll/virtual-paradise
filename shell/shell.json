{
  "bar": {
    "centerAnchor": "__USER__.clock",
    "layout": {
      "center": [
        {
          "id": "__USER__.media"
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "__USER__.weather"
        },
        {
          "id": "__USER__.clock",
          "format": "d MMMM 'W'ww yyyy",
          "formatAlt": "yyyy-MM-dd HH:mm:ss",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "__USER__.memory"
        },
        {
          "id": "__USER__.cputemp"
        },
        {
          "id": "__USER__.microphone"
        },
        {
          "alwaysShow": true,
          "id": "__USER__.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        }
      ],
      "left": [
        {
          "id": "__USER__.menu"
        },
        {
          "id": "__USER__.workspaces"
        },
        {
          "id": "__USER__.active-window"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "__USER__.monitor"
        },
        {
          "id": "__USER__.bluetooth"
        },
        {
          "id": "__USER__.network"
        },
        {
          "id": "__USER__.audio"
        },
        {
          "id": "__USER__.power",
          "showPercentage": true
        },
        {
          "id": "__USER__.system-update"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "__USER__.lock"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "__USER__.lock"
  ]
}
