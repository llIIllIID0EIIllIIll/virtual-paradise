# =========================================================================
# 🚀 HƯỚNG DẪN CÀI ĐẶT TOÀN BỘ CÔNG CỤ CHO CẤU HÌNH ZSH NÀY (WSL / LINUX / MACOS)
# =========================================================================
#
# 1️⃣ CÀI ĐẶT ZSH & OH MY ZSH & NERD FONTS:
#   - Linux (Debian/Ubuntu): sudo apt update && sudo apt install -y zsh git curl
#   - Oh My Zsh:            sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
#   - Nerd Font gợi ý:      Cài đặt font "JetBrainsMono Nerd Font" hoặc "Hack Nerd Font" cho Terminal 
#                           để hiển thị các icon như , , ☸, 󱁢 không bị lỗi ô vuông.
#
# 2️⃣ CÀI ĐẶT HÀNG LOẠT CÁC CÔNG CỤ TỐI TÂN (MODERN CLI TOOLS):
#   - Ubuntu / Debian:
#       sudo mkdir -p /etc/apt/keyrings
#       wget -qO- https://raw.githubusercontent.com/eza-community/eza/main/deb.asc | sudo gpg --dearmor -o /etc/apt/keyrings/gierens.gpg
#       echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de/ stable main" | sudo tee /etc/apt/sources.list.d/gierens.list
#       sudo apt update && sudo apt install -y eza bat ripgrep fd-find zoxide htop btop duf ncdu gping fastfetch fzf micro
#       # Lưu ý: - Cài đặt 'yazi' bằng snap: sudo snap install yazi --classic
#       #        - Cài đặt 'dust' (Disk Usage) bằng snap: sudo snap install dust
#       #          Hoặc cài qua cargo (bản cũ tương thích Cargo < 1.85): cargo install --version 1.1.1 du-dust
# 
#   - Arch Linux:
#       sudo pacman -S --noconfirm eza bat ripgrep fd zoxide htop btop duf ncdu gping fastfetch yazi fzf dust micro
#
#   - macOS (Homebrew):
#       brew install eza bat ripgrep fd zoxide htop btop duf ncdu gping fastfetch yazi fzf lsd dust micro
#
# 3️⃣ CÀI ĐẶT PLUGINS & CUSTOM THEME:
#   - Cài đặt zsh-completions:
#       git clone https://github.com/zsh-users/zsh-completions ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions
#   - Cài đặt zsh-autosuggestions:
#       git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-autosuggestions
#   - Cài đặt zsh-syntax-highlighting:
#       git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-syntax-highlighting
#
# 4️⃣ TROUBLESHOOTING / SỬA LỖI PHỔ BIẾN:
#   - Lỗi "Insecure completion-dependent directories" (Mất Autocompletion do sai phân quyền):
#       Chạy lệnh sau để đưa quyền hạn về mức an toàn (755):
#       chmod -R 755 ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins
#       compaudit | xargs chmod g-w,o-w 2>/dev/null
#   - Làm mới bộ nhớ đệm Completion (Khi lệnh mới cài không hiện gợi ý):
#       rm -f ~/.zcompdump*; compinit
#   - Tải lại cấu hình nhanh: 
#       source ~/.zshrc (hoặc gõ alias 'src')
#
# =========================================================================
# ⚙️ OH MY ZSH CORE CONFIGURATION (CẤU HÌNH LÕI OH MY ZSH)
# =========================================================================

# Đường dẫn đến thư mục cài đặt Oh My Zsh (mặc định là thư mục .oh-my-zsh trong thư mục Home của người dùng)
export ZSH="$HOME/.oh-my-zsh"

# Khai báo kiểu Terminal để hỗ trợ hiển thị đầy đủ 256 màu sắc (tối ưu cho giao diện CLI hiện đại)
export TERM=xterm-256color

# Cấu hình màu sắc hiển thị khi dùng lệnh ls hoặc các lệnh quản lý file. 
# ow: thư mục có quyền ghi cho người khác (other-writable) với nền màu xanh lục/chữ đen
# tw: thư mục có thuộc tính sticky bit và ghi được bởi người khác (sticky & other-writable)
# st: thư mục có thuộc tính sticky bit nhưng không ghi được bởi người khác
# di: thư mục thông thường (màu xanh lam)
# fi: tệp tin thông thường (màu trắng mặc định)
export LS_COLORS="ow=01;30;44:tw=01;30;44:st=01;30;44:di=01;34:fi=0"

# Thiết lập trình biên soạn văn bản mặc định của Terminal. "code --wait" nghĩa là khi chạy các lệnh cần soạn thảo (như sửa commit git),
# Terminal sẽ mở VS Code và tạm dừng chờ cho đến khi bạn đóng tab soạn thảo trong VS Code thì mới tiếp tục chạy trong Terminal.
export EDITOR="code --wait"

# Thiết lập bộ phân trang văn bản mặc định (dùng để đọc các văn bản dài hoặc log vượt quá chiều cao màn hình)
export PAGER="less"

# Cấu hình các cờ tối ưu hóa cho công cụ 'less':
# -F: Tự động thoát less nếu nội dung văn bản ngắn và vừa khít một màn hình
# -g: Chỉ làm nổi bật kết quả khớp cuối cùng khi tìm kiếm để đỡ rối mắt
# -i: Bỏ qua phân biệt chữ hoa chữ thường khi tìm kiếm trừ khi từ khóa có chữ viết hoa
# -M: Hiển thị thanh trạng thái chi tiết hơn ở cuối màn hình (vị trí dòng, phần trăm file đã đọc)
# -R: Cho phép hiển thị trực tiếp các mã màu ANSI (giúp giữ nguyên định dạng màu của log)
# -S: Không tự động xuống dòng dài mà cắt ngang (cho phép cuộn ngang bằng phím mũi tên) giúp log dạng bảng không bị vỡ dòng
# -w: Tạm thời làm nổi bật dòng đầu tiên sau khi cuộn trang để người dùng dễ theo dõi tiếp
# -X: Không xóa nội dung hiển thị của less khỏi màn hình terminal sau khi thoát
# -z-4: Thiết lập kích thước cuộn trang mặc định
export LESS="-F -g -i -M -R -S -w -X -z-4"

# Tắt nạp lại giao diện mặc định (theme rỗng) vì chúng ta sẽ tự thiết kế giao diện HUD cực đẹp ở phía dưới
ZSH_THEME=""

# Tối ưu hóa hiệu suất khởi động shell bằng cách tắt tính năng tự động đổi tiêu đề tab Terminal theo câu lệnh đang chạy
DISABLE_AUTO_TITLE="true"

# Tối ưu hóa hiệu suất hiển thị thư mục Git bằng cách không quét các file mới tạo chưa được add (giúp tránh lag khi cd vào dự án lớn)
DISABLE_UNTRACKED_FILES_DIRTY="true"

# Chỉ chạy các phần khởi tạo nặng khi mở shell lần đầu (Tối ưu hóa tốc độ reload 'src' xuống <5ms)
if [[ -z "$_ZSHRC_INITIALIZED" ]]; then
  # Tự động nạp đường dẫn chứa các file hoàn thành lệnh (autocompletions) của plugin zsh-completions trước khi nạp Oh My Zsh
  fpath+=("${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src")

  # Chỉ định danh sách các plugin nội bộ của Oh My Zsh và các plugin custom bên thứ ba sẽ được tải khi mở shell
  plugins=(
    git                       # Tích hợp các shortcut, gợi ý lệnh và hiển thị trạng thái Git
    zsh-completions           # Thư viện bổ sung gợi ý hoàn thành cho hàng trăm lệnh phổ biến
    zsh-autosuggestions       # Tự động gợi ý lệnh mờ khi đang gõ dựa theo lịch sử lệnh đã gõ trước đó
    zsh-syntax-highlighting   # Tô màu cú pháp câu lệnh thời gian thực
  )

  # Nạp tập lệnh khởi động cốt lõi của Oh My Zsh
  source $ZSH/oh-my-zsh.sh

  # Cấu hình màu sắc tô cú pháp động theo ngữ cảnh (Dynamic Syntax Highlighting)
  typeset -A ZSH_HIGHLIGHT_STYLES
  ZSH_HIGHLIGHT_STYLES[command]='fg=#00ff88,bold'               # Lệnh hợp lệ: Hacker Green
  ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#ff0055,bold'          # Lệnh sai / không tồn tại: Neon Warning Red
  ZSH_HIGHLIGHT_STYLES[alias]='fg=#00f5d4,bold'                  # Biệt danh / Alias: Miku Cyan
  ZSH_HIGHLIGHT_STYLES[builtin]='fg=#ffb7d5,bold'                # Lệnh nội tại shell: Sakura Pink
  ZSH_HIGHLIGHT_STYLES[function]='fg=#00f5d4,bold'               # Hàm shell: Miku Cyan
  ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#7091a4'            # Ký hiệu phân tách (; && |): Muted Slate
  ZSH_HIGHLIGHT_STYLES[path]='fg=#00f5d4,underline'              # Đường dẫn thư mục/tệp tin: Cyan gạch chân
  ZSH_HIGHLIGHT_STYLES[path_prefix]='fg=#00f5d4'
  ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#ffe066'      # Chuỗi trong nháy đơn: Cyber Yellow
  ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#ffe066'      # Chuỗi trong nháy kép: Cyber Yellow
  ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg=#ffb7d5' # Biến môi trường $VAR: Sakura Pink
  ZSH_HIGHLIGHT_STYLES[back-quoted-argument]='fg=#ffb7d5'        # Lệnh con `command`: Sakura Pink
  ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#39c5bb'        # Cờ tùy chọn ngắn (-a, -f): Cyan Blue
  ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#39c5bb'        # Cờ tùy chọn dài (--help): Cyan Blue
  ZSH_HIGHLIGHT_STYLES[cursor]='bg=#00f5d4'

  # Cấu hình gợi ý lệnh mờ (Autosuggestions)
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#7091a4"
fi

# =========================================================================
# 💻 USER & ENVIRONMENT CONFIGURATION (CẤU HÌNH NGƯỜI DÙNG & MÔI TRƯỜNG)
# =========================================================================

# Tối ưu hóa kích thước và cách lưu lịch sử (History)
HISTSIZE=50000                 # Số lượng câu lệnh tối đa được lưu trữ trong bộ nhớ đệm (RAM) của phiên làm việc hiện tại
SAVEHIST=50000                 # Số lượng câu lệnh tối đa được ghi và lưu trữ vĩnh viễn vào file lịch sử (~/.zsh_history)
setopt APPEND_HISTORY          # Khi một câu lệnh chạy xong, nó sẽ được ghi ngay lập tức vào file lịch sử thay vị đợi đóng tab Terminal
setopt SHARE_HISTORY           # Chia sẻ lịch sử lệnh tức thì giữa tất cả các tab/cửa sổ Terminal đang mở (gõ lệnh ở tab 1, tab 2 có thể dùng ngay bằng phím mũi tên lên)
setopt HIST_IGNORE_ALL_DUPS    # Nếu nhập lệnh trùng lặp với lệnh đã có trước đó trong lịch sử, Zsh sẽ xóa bản cũ đi và chỉ lưu bản mới nhất (tiết kiệm không gian)
setopt HIST_REDUCE_BLANKS      # Tự động loại bỏ các khoảng trắng thừa ở đầu, giữa và cuối câu lệnh trước khi lưu vào lịch sử
setopt HIST_IGNORE_SPACE       # Nếu gõ dấu cách trước một câu lệnh, lệnh đó sẽ KHÔNG được lưu vào lịch sử (rất hữu ích khi chạy lệnh chứa mật khẩu, API key, token để tránh rò rỉ)
setopt HIST_VERIFY             # Khi gọi lại lệnh từ lịch sử bằng các ký tự đặc biệt (như !!, !python), Zsh sẽ hiển thị lệnh đó ra để bạn kiểm tra trước, ấn Enter lần nữa mới chạy thật

# Vô hiệu hóa tính năng AT-SPI bridge của bộ công cụ GTK nhằm tăng tốc độ khởi động các ứng dụng đồ họa từ Terminal và ngăn chặn các thông báo cảnh báo rác liên quan đến khả năng truy cập.
export NO_AT_BRIDGE=1

# Các biến môi trường cấu hình cho bộ gõ tiếng Việt Fcitx hoạt động chính xác trong các ứng dụng GUI chạy từ Terminal:
export GTK_IM_MODULE=fcitx     # Cấu hình module nhập liệu cho các ứng dụng viết bằng GTK (như GIMP, Chrome, ...) dùng Fcitx
export QT_IM_MODULE=fcitx      # Cấu hình module nhập liệu cho các ứng dụng viết bằng Qt (như VLC, VirtualBox, ...) dùng Fcitx
export XMODIFIERS=@im=fcitx    # Cấu hình bộ nhập liệu cho các ứng dụng X11 cổ điển dùng Fcitx

# --- Sửa lỗi các phím Home, End, Delete, Ctrl+Mũi tên trong Zsh (Best Practice) ---
# Trong một số Terminal (như trên WSL hoặc ssh), các phím chức năng này bị nhận diện sai ký tự điều khiển.
# Các dòng bindkey dưới đây ánh xạ chính xác mã phím vật lý sang hàm điều khiển dòng lệnh của Zsh.
bindkey '^[[H' beginning-of-line      # Ánh xạ mã phím Home -> Di chuyển con trỏ về đầu dòng lệnh
bindkey '^[[F' end-of-line            # Ánh xạ mã phím End -> Di chuyển con trỏ về cuối dòng lệnh
bindkey '^[[3~' delete-char           # Ánh xạ mã phím Delete -> Xóa ký tự nằm ngay dưới con trỏ
bindkey '^[[1;5C' forward-word        # Ánh xạ mã phím Ctrl + Mũi tên Phải -> Di chuyển con trỏ sang phải 1 từ
bindkey '^[[1;5D' backward-word       # Ánh xạ mã phím Ctrl + Mũi tên Trái -> Di chuyển con trỏ sang trái 1 từ
bindkey '^H' backward-kill-word      # Ánh xạ mã phím Ctrl + Backspace (hoặc mã '^H') -> Xóa toàn bộ 1 từ phía trước con trỏ

# =========================================================================
# 🧭 ADVANCED NAVIGATION & AUTOCOMPLETION (Di chuyển & Tự động hoàn thành)
# =========================================================================

setopt AUTO_CD              # Tiện ích tự động di chuyển: chỉ cần gõ đường dẫn thư mục (ví dụ: /var/log hoặc ..) mà không cần gõ từ khóa `cd`, Zsh tự hiểu và di chuyển vào đó
setopt AUTO_PUSHD           # Tự động đẩy thư mục vừa cd vào stack lịch sử (Directory Stack), giúp bạn dễ dàng quay lại các thư mục cũ bằng lệnh `popd` hoặc `cd -`
setopt PUSHD_IGNORE_DUPS    # Không thêm các thư mục trùng lặp vào stack lịch sử di chuyển thư mục

# Cấu hình hệ thống gợi ý lệnh (autocompletion) thông minh:
# 'm:{a-zA-Z}={A-Za-z}': Không phân biệt chữ hoa/chữ thường khi gợi ý hoàn thành (ví dụ gõ 'doc' vẫn gợi ý thư mục 'Documents')
# 'r:|[._-]=* r:|=*': Cho phép tự động hoàn thành từ các phần viết tắt phân tách bởi dấu chấm, gạch dưới hoặc gạch ngang (ví dụ gõ 'a_b' gợi ý 'apple_banana')
# 'l:|=* r:|=*': Gợi ý thông minh bao gồm cả các kết quả khớp ở giữa từ
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# Cấu hình hiển thị menu điều hướng trực quan khi bấm nút Tab 2 lần liên tiếp.
# Thay vì hiển thị danh sách tĩnh, nó hiển thị menu động mà bạn có thể dùng các phím mũi tên lên/xuống/trái/phải để chọn file/thư mục.
zstyle ':completion:*' menu select

# Định dạng các dòng văn bản hiển thị tiêu đề và cảnh báo trong menu hoàn thành gợi ý:
# %F{green}...%f: Màu xanh lục cho phần mô tả nhóm gợi ý (ví dụ: -- files --, -- commands --)
# %F{red}...%f: Màu đỏ cho các cảnh báo khi không tìm thấy kết quả phù hợp
zstyle ':completion:*:descriptions' format '%F{green}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}Không tìm thấy tệp/lệnh khớp cho:%f %d'

# Cấu hình màu sắc giao diện cho FZF (Fuzzy Finder - công cụ tìm kiếm mờ nhanh chóng)
# Nếu hệ thống của bạn có cài đặt lệnh `fzf`, đoạn mã dưới đây sẽ thiết lập bảng màu tối ưu (Cyber Pastel)
# match với theme chính: chữ màu hồng, viền xanh neon, dòng đang chọn nền Dracula dark, con trỏ hồng/vàng.
if (( $+commands[fzf] )); then
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --color="fg:#eafbfa,bg:-1,hl:#00f5d4,fg+:#00ff88,bg+:#0e141d,hl+:#00ff88,info:#7091a4,prompt:#00f5d4,pointer:#00ff88,marker:#ffb7d5,spinner:#ffe066,header:#7091a4,border:#00f5d4"'
fi

# =========================================================================
# 🏷️ CUSTOM ALIASES & MODERN TOOLS (WITH FALLBACKS)
# =========================================================================
# Định nghĩa các biệt danh (Alias) viết tắt hoặc thay thế các lệnh Linux truyền thống bằng các công cụ hiện đại, tối ưu hơn.
# Sử dụng kiểm tra điều kiện `(( $+commands[tool] ))` để xác định công cụ đó đã được cài đặt trong hệ thống chưa,
# nếu chưa sẽ tự động rơi về cấu hình công cụ dự phòng (fallback) tiếp theo hoặc lệnh mặc định của Linux.

# --- 1. Thay thế lệnh hiển thị danh sách file `ls` ---
# Mức ưu tiên 1: Lệnh `eza` (Bản nâng cấp hiện đại của `ls`, viết bằng Rust, hiển thị icon đẹp, trạng thái Git, cấu trúc thư mục rõ ràng)
if (( $+commands[eza] )); then
  alias ls='eza --icons --git --group-directories-first'         # ls: Hiển thị file kèm icon, trạng thái Git của file, đẩy thư mục lên đầu tiên
  alias ll='eza -alF --icons --git --group-directories-first'     # ll: Hiển thị dạng danh sách chi tiết (quyền hạn, kích thước, chủ sở hữu, ngày tạo, trạng thái git)
  alias la='eza -a --icons --group-directories-first'            # la: Hiển thị cả các file ẩn (bắt đầu bằng dấu chấm .) kèm icon
  alias l='eza -F --icons --group-directories-first'             # l: Hiển thị danh sách file rút gọn phân loại theo đuôi thư mục
  alias tree='eza --tree --icons'                                # tree: Hiển thị sơ đồ cây thư mục trực quan kèm icon sinh động

# Mức ưu tiên 2 (Fallback): Lệnh `lsd` (Công cụ tương tự `eza`, hiển thị icon đẹp và phân nhóm thư mục trước)
elif (( $+commands[lsd] )); then
  alias ls='lsd --group-dirs first'
  alias ll='lsd -alF --group-dirs first'
  alias la='lsd -a --group-dirs first'
  alias l='lsd -F --group-dirs first'
  alias tree='lsd --tree'

# Mức ưu tiên cuối cùng: Lệnh `ls` truyền thống của Linux (vẫn đảm bảo hệ thống chạy được khi chưa cài eza hay lsd)
else
  alias ll='ls -alF'
  alias la='ls -A'
  alias l='ls -CF'
fi

# --- 2. Thay thế lệnh đọc file `cat` ---
