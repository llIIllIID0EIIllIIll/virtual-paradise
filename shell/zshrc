# Module D: Advanced Git Repository Status (Official Git/Catppuccin colors)
function zsh_git_status() {
  REPLY=""
  # Executes git status once in porcelain v2 format (0 unnecessary forks)
  # Returns immediately if directory is not a git repository
  local gstatus
  gstatus=$(git status --porcelain=v2 --branch 2>/dev/null) || return
  
  local -a lines
  lines=(${(f)gstatus})
  
  # Extract branch name or short SHA if in detached HEAD state
  local branch_line="${(M)lines[@]:#*branch.head *}"
  local branch="${branch_line#*branch.head }"
  if [[ "$branch" == "(detached)" ]]; then
    local oid_line="${(M)lines[@]:#*branch.oid *}"
    local oid="${oid_line#*branch.oid }"
    branch="${oid[1,7]}"
  fi
  
  # Count staged, unstaged, and untracked changes
  local staged=${#${(M)lines[@]:#[12] [^.]*}}
  local unstaged=${#${(M)lines[@]:#[12] ?[^.]*}}
  local untracked=${#${(M)lines[@]:#\? *}}
  
  # Extract ahead / behind commit counters relative to remote
  local ahead=0
  local behind=0
  local ab_line="${(M)lines[@]:#*branch.ab *}"
  if [[ -n "$ab_line" ]]; then
    local ab_vals="${ab_line#*branch.ab }"
    local -a parts
    parts=(${(s: :)ab_vals})
    ahead="${parts[1]#+}"
    behind="${parts[2]#-}"
  fi
  
  # Git stats indicator badge:
  local git_details=""
  if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
    # Omit ANSI colors in pill mode to maintain high contrast on gradient bg
    [[ $staged -gt 0 ]] && git_details+="+${staged}"
    [[ $unstaged -gt 0 ]] && git_details+="${git_details:+ }!${unstaged}"
    [[ $untracked -gt 0 ]] && git_details+="${git_details:+ }?${untracked}"
    [[ $ahead -gt 0 ]] && git_details+="${git_details:+ }⇡${ahead}"
    [[ $behind -gt 0 ]] && git_details+="${git_details:+ }⇣${behind}"
  else
    [[ $staged -gt 0 ]] && git_details+="%F{#8CC84B}+${staged}%f"        # +: Staged files counter (green)
    [[ $unstaged -gt 0 ]] && git_details+="${git_details:+ }%F{#FFD43B}!${unstaged}%f" # !: Modified files counter (yellow)
    [[ $untracked -gt 0 ]] && git_details+="${git_details:+ }%F{#FF6070}?${untracked}%f" # ?: Untracked files counter (red)
    [[ $ahead -gt 0 ]] && git_details+="${git_details:+ }%F{#00FFDD}⇡${ahead}%f"    # ⇡: Ahead commits counter (cyan)
    [[ $behind -gt 0 ]] && git_details+="${git_details:+ }%F{#FF6070}⇣${behind}%f"  # ⇣: Behind commits counter (red)
  fi
  
  # Render output string:
  local bg fg content
  if (( staged + unstaged + untracked > 0 )); then
    bg="$BG_GIT_DIRTY"
    fg="$FG_GIT_DIRTY"
    if [[ -n "$git_details" ]]; then
      content="${I_GIT} ${branch} [${git_details}]"
    else
      content="${I_GIT} ${branch}*"
    fi
  else
    bg="$BG_GIT_CLEAN"
    fg="$FG_GIT_CLEAN"
    if [[ -n "$git_details" ]]; then
      content="${I_GIT} ${branch} [${git_details}]"
    else
      content="${I_GIT} ${branch}"
    fi
  fi

  if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
    if (( staged + unstaged + untracked > 0 )); then
      zsh_make_gradient_pill "#f38ba8" "#f9e2af" "#11111b" "$content"
    else
      zsh_make_gradient_pill "#a6e3a1" "#94e2d5" "#11111b" "$content"
    fi
  else
    # Classic style
    if (( staged + unstaged + untracked > 0 )); then
      if [[ -n "$git_details" ]]; then
        # Display branch in alert red with detailed counters
        REPLY="${C_ALERT}${I_GIT} ${C_DATA}${branch}%f [${git_details}]${C_DIM}${I_SEP} "
      else
        # Uncommitted changes detected without tracked files (e.g. submodules)
        REPLY="${C_ALERT}${I_GIT} ${C_DATA}${branch}*${C_DIM}${I_SEP} "
      fi
    else
      # Clean repository state:
      if [[ -n "$git_details" ]]; then
        # Clean working tree with ahead/behind commits relative to remote
        REPLY="${C_ACCENT}${I_GIT} ${C_DATA}${branch}%f [${git_details}]${C_DIM}${I_SEP} "
      else
        # Clean and synchronized with upstream
        REPLY="${C_ACCENT}${I_GIT} ${C_DATA}${branch}${C_DIM}${I_SEP} "
      fi
    fi
  fi
}

