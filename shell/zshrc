# A. Command Execution Duration Module (Exec Time)
# preexec hook: Executed by Zsh immediately before command runs
function preexec() { 
  cmd_start=$EPOCHREALTIME; # Record precise command start timestamp
}

# =========================================================================
# 🚨 CYBERPUNK WINDOW ERROR BORDER & GLOW HOOK (HYPRLAND)
# =========================================================================
typeset -g _omarchy_last_err_state=0

function _omarchy_error_border_hook() {
  local exit_code="$1"
  if [[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]]; then
    if [[ $exit_code -ne 0 && $_omarchy_last_err_state -eq 0 ]]; then
      _omarchy_last_err_state=1
      (~/.local/bin/hypr_window_error_shake.sh &>/dev/null &!)
    elif [[ $exit_code -eq 0 && $_omarchy_last_err_state -ne 0 ]]; then
      _omarchy_last_err_state=0
      (~/.local/bin/hypr_window_error_restore.sh &>/dev/null &!)
    fi
  fi
}

# precmd hook: automatically executed by Zsh immediately before rendering new prompt
function precmd() {
  # Capture exit status ($?) immediately before background tasks overwrite it
  # Preserves accurate exit code for error badge rendering
  exit_status=$?
  _omarchy_error_border_hook "$exit_status"

  # If command execution timer is active
  if [ -n "$cmd_start" ]; then
    # Compute elapsed duration in seconds
    local duration=$(($EPOCHREALTIME - $cmd_start))
    
    # Display execution duration only if command took longer than 0.5s
    if (( duration > 0.5 )); then
      local formatted_time=""
      # Format hours, minutes, and seconds if duration >= 1h
      if (( duration >= 3600 )); then
        integer hours=$(( duration / 3600 ))
        integer mins=$(( (duration - hours * 3600) / 60 ))
        local secs=$(( duration - (hours * 3600) - (mins * 60) ))
        formatted_time="$(printf "%dh %dm %.1fs" $hours $mins $secs)"
      # Format minutes and seconds if duration >= 1m
      elif (( duration >= 60 )); then
        integer mins=$(( duration / 60 ))
        local secs=$(( duration - (mins * 60) ))
        formatted_time="$(printf "%dm %.1fs" $mins $secs)"
      # Format sub-minute seconds with 2 decimal places
      else
        formatted_time="$(printf "%.2fs" $duration)"
      fi
      # Format duration badge with lightning icon
      cmd_time="${C_ALERT}${I_EXEC} ${formatted_time}${C_DIM}${I_SEP} "
    else
      cmd_time="" # Suppress duration for fast commands
    fi
    unset cmd_start # Reset timer for next command
  else
    cmd_time=""
  fi

  # Cache dynamic module values so zsh_top_line renders in < 0.5ms during window resize.
  # Heavy evaluations (git status) execute once in the main shell without extra forks.
  # Real-time stats (RAM, Temp, Wi-Fi, Battery) are optimized to < 0.6ms total latency.
  # Background telemetry daemon handles asynchronous sensor updates.

  local REPLY
  zsh_user_info; _CACHE_USER_INFO="$REPLY"
  zsh_dir_info; _CACHE_DIR_INFO="$REPLY"
  zsh_git_status; _CACHE_GIT_STATUS="$REPLY"
  zsh_tool_context; _CACHE_TOOL_CONTEXT="$REPLY"
  zsh_bottom_status; _CACHE_BOTTOM_STATUS="$REPLY"

  if [[ $exit_status -eq 0 ]]; then
    _CACHE_ARROW_COLOR="${C_ACCENT}"
  else
    _CACHE_ARROW_COLOR="${C_ALERT}"
  fi

  # Single-quoted PROMPT allows dynamic re-evaluation on window resize signals.
  # TRAPWINCH triggers zle reset-prompt -> recalculating layout dynamically.
  # Keeps right-aligned HUD perfectly flush with the terminal border.
  # Direct variable expansion removes subshell execution overhead.
  PROMPT='$(zsh_top_line)
${C_DIM}${L_BOT} ${_CACHE_BOTTOM_STATUS}${_CACHE_ARROW_COLOR}${I_ARROW} ${C_RESET}'
}

