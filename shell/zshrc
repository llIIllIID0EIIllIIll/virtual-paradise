# [5] portkill: Giải phóng một cổng mạng đang bị chiếm dụng bằng cách tìm PID của tiến trình sử dụng và tắt (kill) nó đi.
# -> Cách dùng: portkill <số_cổng_mạng>
# -> Ví dụ: portkill 3000
function portkill() {
  # Kiểm tra xem người dùng đã nhập số cổng mạng cần giải phóng chưa
  if [ -z "$1" ]; then
    print -P "%F{yellow}[WARN]%f Lỗi: Vui lòng nhập số cổng cần giải phóng! (Ví dụ: portkill 8080)"
    return 1
  fi
  # lsof -t -i:"$1": Trả về duy nhất ID tiến trình (PID) đang lắng nghe trên cổng truyền vào
  local pid=$(lsof -t -i:"$1")
  if [ -n "$pid" ]; then
    print -P "%F{blue}[INFO]%f Đang yêu cầu dừng tiến trình PID: $pid chiếm dụng cổng $1 (SIGTERM)..."
    kill $pid 2>/dev/null
    
    # Chờ 0.5 giây kiểm tra xem tiến trình đã tắt hẳn chưa
    sleep 0.5
    if kill -0 $pid 2>/dev/null; then
      print -P "%F{yellow}[WARN]%f Tiến trình không tự tắt. Đang cưỡng bức dừng (SIGKILL)..."
      kill -9 $pid 2>/dev/null
    fi
    print -P "%F{green}[OK]%f Đã giải phóng cổng $1."
  else
    print -P "%F{blue}[INFO]%f Không tìm thấy tiến trình nào đang chiếm dụng cổng $1."
  fi
}

# [6] glog: Tìm kiếm chi tiết lịch sử Git commit theo từ khóa trong tin nhắn commit (commit message).
# -> Cách dùng: glog "<từ_khóa>"
# -> Ví dụ: glog "sửa lỗi thanh toán"
function glog() {
  # Kiểm tra tham số từ khóa đầu vào
  if [ -z "$1" ]; then
    print -P "%F{yellow}[WARN]%f Lỗi: Vui lòng nhập từ khóa tìm kiếm commit! (Ví dụ: glog \"fix lint\")"
    return 1
  fi
  # Kiểm tra xem có ở trong Git repository không trước khi chạy lệnh
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    print -P "%F{red}[ERROR]%f Lỗi: Thư mục hiện hành không phải là Git repository!"
    return 1
  fi
  # git log --all: Tìm trên tất cả các nhánh
  # --grep="$1": Lọc ra những commit có tin nhắn chứa từ khóa
  # --oneline: Định dạng kết quả hiển thị ngắn gọn trên một dòng gồm (mã hash commit + nội dung tin nhắn)
  git log --all --grep="$1" --oneline
}

# [7] server: Khởi động máy chủ Web Server tĩnh nhanh tại thư mục hiện tại để phục vụ việc kiểm thử các trang web tĩnh (HTML, CSS, JS).
# -> Cách dùng: server [số_cổng_tùy_chọn] (Mặc định sẽ lấy cổng 8000 nếu không truyền)
# -> Ví dụ: server 9000
function server() {
  # Gán biến port bằng tham số thứ nhất truyền vào ($1). Nếu trống, mặc định lấy cổng 8000
  local port="${1:-8000}"
  
  # Cách 1: Nếu hệ thống có cài đặt Python 3, dùng module http.server của Python 3 để chạy server
  if (( $+commands[python3] )); then
    print -P "%F{green}[OK]%f Khởi động HTTP Server bằng Python 3 tại địa chỉ: http://localhost:$port"
    python3 -m http.server "$port"
    
  # Cách 2: Nếu chỉ có Python 2, dùng SimpleHTTPServer để chạy server
  elif (( $+commands[python] )); then
    print -P "%F{green}[OK]%f Khởi động HTTP Server bằng Python tại địa chỉ: http://localhost:$port"
    python -m SimpleHTTPServer "$port"
    
  # Cách 3: Nếu có pnpm (NodeJS), dùng thư viện http-server tải nhanh và chạy trực tiếp
  elif (( $+commands[pnpm] )); then
    print -P "%F{green}[OK]%f Khởi động HTTP Server bằng Node (http-server) tại địa chỉ: http://localhost:$port"
    pnpm dlx http-server -p "$port"
    
  # Nếu không có công cụ nào ở trên, báo lỗi yêu cầu cài đặt
  else
    print -P "%F{red}[ERROR]%f Lỗi: Hệ thống chưa cài đặt Python hoặc Node/pnpm để khởi động Server."
    return 1
  fi
}

# [8] backup: Tạo nhanh một bản sao lưu an toàn cho file hoặc thư mục chỉ định bằng cách nhân bản nó với phần đuôi .bak hoặc _bak.
# -> Cách dùng: backup <tên_tệp_hoặc_thư_mục>
# -> Ví dụ: backup config.json (Sẽ tạo ra file config.bak)
function backup() {
  # Kiểm tra tham số tên tệp/thư mục đầu vào
  if [ -z "$1" ]; then
    print -P "%F{yellow}[WARN]%f Lỗi: Vui lòng nhập tên tệp hoặc thư mục cần sao lưu!"
    return 1
  fi
  
  local filename="$1"
  # Tách đuôi mở rộng cũ và đổi thành đuôi .bak (Ví dụ: database.db thành database.bak)
  local backup_name="${filename%.*}.bak"
  
  # Nếu đối tượng cần sao lưu là một thư mục (-d), chuyển tên bản sao thành dạng: tên_thư_mục_bak
  if [ -d "$filename" ]; then
    backup_name="${filename}_bak"
  fi
  
  # cp -r: Sao chép đệ quy cả tệp và thư mục con sang vị trí mới
  cp -r "$filename" "$backup_name"
  print -P "%F{green}[OK]%f Đã tạo bản sao lưu thành công từ '$filename' thành '$backup_name'"
}

# [9] mkfile: Tạo một tệp tin mới bất kỳ và tự động tạo toàn bộ các thư mục cha nếu chưa tồn tại.
# -> Cách dùng: mkfile <đường_dẫn_tệp_cần_tạo>
# -> Ví dụ: mkfile app/components/modals/LoginModal.tsx
function mkfile() {
  # Kiểm tra xem người dùng đã nhập đường dẫn tệp tin cần tạo chưa
  if [ -z "$1" ]; then
    print -P "%F{yellow}[WARN]%f Lỗi: Vui lòng nhập đường dẫn tệp tin cần tạo!"
    return 1
  fi
  # dirname "$1": Lấy ra đường dẫn thư mục chứa tệp tin đó (Ví dụ: app/components/modals/)
  # mkdir -p: Tạo toàn bộ cây thư mục đó nếu chưa có sẵn
  # && touch "$1": Sau khi tạo thư mục cha xong, tạo tệp tin trống bằng lệnh touch
  mkdir -p "$(dirname "$1")" && touch "$1"
}

# [10] dirsize: Liệt kê chi tiết dung lượng của các tệp & thư mục con hiện tại, sắp xếp theo thứ tự giảm dần.
# -> Cách dùng: dirsize
function dirsize() {
  print -P "%F{blue}[INFO]%f Đang đo kích thước các tệp và thư mục..."
  # du -sh *: Đo kích thước của tất cả file/thư mục trong thư mục hiện tại dưới định dạng dễ đọc (-h) và tổng hợp (-s)
  # Sử dụng 'command du' để tránh bị đè bởi các alias du='dust' hoặc du='ncdu'
  # 2>/dev/null: Bỏ qua các cảnh báo lỗi phân quyền khi truy cập một số file hệ thống
  # sort -hr: Sắp xếp kết quả theo dung lượng số học giảm dần (-h cho dung lượng dễ đọc, -r đảo ngược từ lớn đến bé)
  command du -sh * 2>/dev/null | sort -hr
}

# [11] f: Bộ công cụ tìm kiếm tối thượng (Ultimate Search Tool)
# Tích hợp tìm kiếm: Thư mục (cd), Tệp tin (open), Nội dung tệp (ripgrep), Lịch sử lệnh (history), Tiến trình (kill).
function f() {
  local mode="$1"             # Gán biến mode bằng tham số thứ nhất truyền vào (chế độ tìm kiếm)
  local start_path="${2:-.}"  # Gán biến start_path bằng tham số thứ hai (đường dẫn bắt đầu), mặc định là thư mục hiện tại (.)

  # Đồng bộ icon với Zsh theme (sử dụng các biến toàn cục nếu có, kèm fallback)
  local i_dir="${I_DIR:-}"         # Biểu tượng thư mục
  local i_file="${I_FILE:-󰈙}"        # Biểu tượng tệp tin
  local i_search="${I_SEARCH:-}"    # Biểu tượng tìm kiếm
  local i_history="${I_HISTORY:-}"  # Biểu tượng lịch sử
  local i_jobs="${I_JOBS:-}"        # Biểu tượng tiến trình ngầm

  # Xác định câu lệnh fd khả dụng (fdfind trên Debian/Ubuntu, fd trên macOS/Arch)
  local fd_cmd=""             # Biến lưu tên câu lệnh tìm kiếm tệp/thư mục
  if (( $+commands[fd] )); then
    fd_cmd="fd"               # Dùng lệnh fd nếu hệ thống có sẵn
  elif (( $+commands[fdfind] )); then
    fd_cmd="fdfind"           # Dùng lệnh fdfind (phổ biến trên Debian/Ubuntu)
  else
    rehash                    # Cập nhật lại danh sách lệnh trong PATH
    if (( $+commands[fd] )); then
      fd_cmd="fd"             # Thử tìm lại lệnh fd
    elif (( $+commands[fdfind] )); then
      fd_cmd="fdfind"         # Thử tìm lại lệnh fdfind
    fi
  fi

  # Xác định câu lệnh bat khả dụng (hỗ trợ hiển thị nội dung tệp tin định dạng màu sắc)
  local bat_cmd=""            # Biến lưu tên câu lệnh bat/batcat
  if (( $+commands[bat] )); then
    bat_cmd="bat"             # Dùng lệnh bat nếu có sẵn
  elif (( $+commands[batcat] )); then
    bat_cmd="batcat"         # Dùng lệnh batcat (trên Debian/Ubuntu)
  fi

  # Định hình giao diện FZF cao cấp (Cyber Pastel Theme matching prompt HUD)
  local -a fzf_style          # Mảng chứa các cấu hình giao diện FZF
  fzf_style=(
    --height="80%"            # Chiều cao khung tìm kiếm chiếm 80% cửa sổ terminal
    --layout="reverse"        # Đảo ngược giao diện (thanh tìm kiếm nằm ở trên cùng)
    --border="rounded"        # Viền khung bo góc tròn hiện đại
    --margin="1"              # Căn lề ngoài 1 dòng
    --padding="1"             # Khoảng đệm trong khung 1 dòng
    --info="inline-right"     # Hiển thị số dòng khớp nằm gọn ở hàng tìm kiếm bên phải
    --color="fg:#FFCCFF,bg:-1,hl:#00FFDD,fg+:#00FFDD,bg+:#282a36,hl+:#00FFDD"  # Cấu hình màu chữ, nền Dracula và từ khóa khớp
    --color="info:#585b70,prompt:#00FFDD,pointer:#00FFDD,marker:#FF6070,spinner:#00FFDD,header:#585b70"  # Màu các thành phần giao diện chỉ dẫn
    --color="border:#00FFDD,label:#00FFDD"  # Màu viền và nhãn tiêu đề là xanh neon
  )

  # Helper to open files in default editor (micro falling back to nano)
  # Hàm phụ giúp mở các tệp tin được chọn bằng editor mặc định
  _f_open_files() {
    local files               # Khai báo biến cục bộ lưu danh sách tệp tin
    files=(${(f)1})           # Tách chuỗi danh sách tệp thành mảng dựa theo ký tự xuống dòng

    if [[ ${#files} -eq 0 ]]; then
      return                  # Nếu không có tệp nào được chọn thì kết thúc hàm
    fi

    local editor="${EDITOR:-${VISUAL:-}}" # Lấy editor mặc định từ biến môi trường
    if [[ -z "$editor" ]]; then
      if (( $+commands[micro] )); then
        editor="micro"        # Dùng micro nếu có sẵn và EDITOR chưa đặt
      elif (( $+commands[nano] )); then
        editor="nano"         # Dùng nano làm phương án dự phòng tiếp theo
      else
        editor="vi"           # Cuối cùng mặc định dùng trình soạn thảo vi
      fi
    fi

    # Ensure editor exists
    # Đảm bảo lệnh editor thực sự tồn tại trong hệ thống trước khi gọi
    if ! (( $+commands[$editor] )) && [[ "$editor" != "vi" && "$editor" != "nano" ]]; then
      if (( $+commands[micro] )); then
        editor="micro"        # Fallback về micro nếu editor chỉ định bị thiếu
      else
        editor="nano"         # Fallback về nano nếu micro cũng không có
      fi
    fi

    $editor "${files[@]}"     # Khởi chạy trình soạn thảo để mở toàn bộ tệp được chọn
  }

  # Helper to open a file in default editor at a specific line number
  # Hàm phụ giúp mở tệp tin và nhảy trực tiếp đến một số dòng cụ thể
  _f_open_in_editor() {
    local file="$1"           # Tham số 1: Đường dẫn tệp tin cần mở
    local line="${2:-}"       # Tham số 2: Số dòng cần nhảy tới (mặc định để trống)

    local editor="${EDITOR:-${VISUAL:-}}" # Lấy trình soạn thảo mặc định của hệ thống
    if [[ -z "$editor" ]]; then
      if (( $+commands[micro] )); then
        editor="micro"        # Fallback về micro nếu chưa cấu hình EDITOR
      elif (( $+commands[nano] )); then
        editor="nano"         # Fallback về nano
      else
        editor="vi"           # Mặc định cuối cùng là vi
      fi
    fi

    # Đảm bảo trình soạn thảo được chọn có thể chạy được trên máy
    if ! (( $+commands[$editor] )) && [[ "$editor" != "vi" && "$editor" != "nano" ]]; then
      if (( $+commands[micro] )); then
        editor="micro"        # Fallback về micro
      else
        editor="nano"         # Fallback về nano
      fi
    fi

    if [[ -n "$line" ]]; then
      case "$editor" in
        micro)
          micro "$file:$line" # Đối với micro, mở tệp theo định dạng path:line
          ;;
        nano)
          nano +"$line" "$file" # Đối với nano, truyền tham số +dòng trước tệp
          ;;
        *)
          $editor "$file"     # Các editor khác thì mở file bình thường
          ;;
      esac
    else
      $editor "$file"         # Nếu không truyền số dòng, mở tệp tin như bình thường
    fi
  }

  # 1. Hàm con: Chọn thư mục và cd (Hỗ trợ phím mũi tên Trái/Phải để chuyển cấp thư mục như Yazi)
  _f_mode_dir() {
    if [[ -z "$fd_cmd" ]]; then
      print -P "%F{red}[ERROR]%f Lỗi: Cần cài đặt 'fd-find' để dùng tính năng này." # Báo lỗi nếu thiếu công cụ tìm kiếm
      return 1                # Dừng hàm và trả về lỗi
    fi
    local current_dir=$(realpath "${1:-.}") # Lấy đường dẫn tuyệt đối của thư mục bắt đầu
    while true; do            # Vòng lặp liên tục để duyệt thư mục động
      local fzf_out           # Biến lưu kết quả trả về từ FZF
      fzf_out=$(command $fd_cmd -t d -H -E .git -E node_modules -E .cache "" "$current_dir" 2>/dev/null | \
                fzf "${fzf_style[@]}" \
                    --expect=left,right \
                    --prompt="$i_dir  Thư mục: $current_dir > " \
                    --header="[Enter] cd vào | [←/→] Thư mục Cha/Con" \
                    --preview="(eza --tree --level=2 --color=always --icons {} || tree -C -L 2 {} || ls -lhA --color=always {} || ls -F {}) 2>/dev/null | head -50" \
                    --preview-window="right:60%,border-left:<80(down:50%,border-top)")
                    # Gọi lệnh tìm kiếm thư mục ẩn (-H), loại trừ thư mục rác (-E), hiển thị bằng FZF kèm khung preview cây thư mục con và bắt phím mũi tên trái/phải
                    
      local exit_status=$?    # Lấy mã trạng thái thoát của FZF
      if [[ $exit_status -eq 130 || -z "$fzf_out" ]]; then
        break                 # Nếu người dùng bấm ESC (mã 130) hoặc không chọn gì, thoát vòng lặp
      fi
      
      local key=$(echo "$fzf_out" | head -n 1)      # Dòng đầu tiên là phím chức năng được bấm (left, right hoặc trống)
      local selected=$(echo "$fzf_out" | tail -n +2) # Dòng tiếp theo là đường dẫn thư mục được chọn
      
      if [[ "$key" == "left" ]]; then
        # Mũi tên trái -> Quay lại thư mục cha
        current_dir=$(dirname "$current_dir")        # Chuyển thư mục hiện hành lên một cấp cha
      elif [[ "$key" == "right" ]]; then
        # Mũi tên phải -> Đi sâu vào thư mục con đã chọn
        if [[ -n "$selected" ]]; then
          current_dir="$selected"                   # Cập nhật thư mục hiện hành sang thư mục con được chọn
        fi
      else
        # Nhấn Enter -> cd vào thư mục đã chọn và kết thúc
        if [[ -n "$selected" ]]; then
          cd "$selected"                            # Chuyển thư mục làm việc của Terminal sang thư mục đã chọn
        fi
        break                                       # Thoát vòng lặp kết thúc lệnh
      fi
    done
  }

  # 2. Hàm con: Chọn tệp và mở bằng Editor (Hỗ trợ phím mũi tên Trái để quay lại thư mục cha như Yazi)
  _f_mode_file() {
    if [[ -z "$fd_cmd" ]]; then
      print -P "%F{red}[ERROR]%f Lỗi: Cần cài đặt 'fd-find' để dùng tính năng này." # Báo lỗi nếu thiếu fd
      return 1                # Dừng hàm và trả về lỗi
    fi
    local current_dir=$(realpath "${1:-.}") # Lấy đường dẫn tuyệt đối của thư mục tìm kiếm
    while true; do            # Bắt đầu vòng lặp duyệt tệp tin
      local fzf_out           # Biến chứa dữ liệu tương tác từ FZF
      fzf_out=$(command $fd_cmd -t f -H -E .git -E node_modules -E .cache "" "$current_dir" 2>/dev/null | \
                fzf "${fzf_style[@]}" \
                    --multi \
                    --expect=left \
                    --prompt="$i_file  Tệp tin: $current_dir > " \
                    --header="[Tab] Chọn nhiều | [Enter] Mở | [←] Cha" \
                    --preview "(${bat_cmd:-cat} --style=numbers --color=always --line-range :100 {} || cat {}) 2>/dev/null | head -100" \
                    --preview-window="right:60%,border-left:<80(down:50%,border-top)")
                    # Tìm kiếm tệp tin (-t f), hỗ trợ chọn nhiều bằng phím Tab (--multi), bắt phím mũi tên trái, xem trước 100 dòng đầu của tệp bằng bat hoặc cat
                    
      local exit_status=$?    # Lưu mã thoát từ FZF
      if [[ $exit_status -eq 130 || -z "$fzf_out" ]]; then
        break                 # Thoát nếu nhấn ESC (130) hoặc kết quả rỗng
      fi
      
      local key=$(echo "$fzf_out" | head -n 1)      # Lấy dòng đầu tiên lưu phím chức năng bắt được
      local selected=$(echo "$fzf_out" | tail -n +2) # Lấy danh sách đường dẫn các file được chọn
      
      if [[ "$key" == "left" ]]; then
        # Mũi tên trái -> Quay lại thư mục cha
        current_dir=$(dirname "$current_dir")        # Lùi thư mục tìm kiếm lên cấp cha
      else
        # Nhấn Enter -> Mở tệp bằng mặc định
        _f_open_files "$selected"                   # Mở danh sách các tệp tin đã chọn bằng editor mặc định
        break                                       # Thoát vòng lặp
      fi
    done
  }

  # 3. Hàm con: Tìm nội dung trong tệp (Live Ripgrep) và mở tại dòng tương ứng
  _f_mode_content() {
    if ! (( $+commands[rg] )); then
      print -P "%F{red}[ERROR]%f Lỗi: Cần cài đặt 'ripgrep' để dùng tính năng này." # Báo lỗi nếu thiếu lệnh rg
      return 1                # Dừng hàm và trả về lỗi
    fi
    
    local search_path="${1:-.}" # Lấy đường dẫn cần tìm kiếm, mặc định là thư mục hiện hành (.)
    local result              # Biến lưu kết quả dòng được chọn từ FZF
    
    result=$(FZF_DEFAULT_COMMAND="rg --column --line-number --no-heading --color=always --smart-case '' \"$search_path\"" \
      fzf "${fzf_style[@]}" \
          --ansi \
          --disabled \
          --delimiter=: \
          --prompt="$i_search  Ripgrep ($search_path) > " \
          --header="[Enter] Mở tệp tại dòng" \
          --bind "change:reload(rg --column --line-number --no-heading --color=always --smart-case {q} \"$search_path\" || true)" \
          --preview "(${bat_cmd:-cat} --style=numbers --color=always --highlight-line {2} {1} 2>/dev/null || cat {1} 2>/dev/null)" \
          --preview-window="right:60%,border-left:<80(down:50%,border-top),+{2}-/2")
          # Live tìm kiếm bằng cách liên kết sự kiện thay đổi ký tự để chạy lại lệnh rg, hiển thị tệp tin và highlight dòng khớp ở khung bên phải
          
    if [[ -n "$result" ]]; then
      local file=$(echo "$result" | cut -d':' -f1) # Trích xuất đường dẫn tệp tin từ kết quả (phần trước dấu hai chấm thứ 1)
      local line=$(echo "$result" | cut -d':' -f2) # Trích xuất số dòng từ kết quả (phần nằm giữa hai dấu hai chấm)
      _f_open_in_editor "$file" "$line"           # Mở tệp tin bằng editor và nhảy thẳng tới dòng tương ứng
    fi
  }

  # 4. Hàm con: Tìm lịch sử lệnh và dán vào dòng lệnh (Deduplicated)
  _f_mode_history() {
    local cmd                 # Biến lưu câu lệnh được chọn từ lịch sử
    cmd=$(fc -rln 1 2>/dev/null | awk '!seen[$0]++' | fzf "${fzf_style[@]}" \
          --prompt="$i_history  Lịch sử lệnh > " \
          --header="[Enter] Dán vào terminal" \
          --preview="echo {}" \
          --preview-window="down:3:wrap")
          # Đọc lịch sử Zsh từ đầu (fc -rln 1), loại bỏ lệnh trùng lặp bằng awk, cho phép tìm kiếm qua FZF
    if [[ -n "$cmd" ]]; then
      print -z "$cmd"         # Dán câu lệnh được chọn trực tiếp vào dòng soạn thảo lệnh của terminal (con trỏ chờ chạy)
    fi
  }

  # 5. Hàm con: Tìm tiến trình đang chạy và kill với các tín hiệu khác nhau
  _f_mode_process() {
    local ps_line             # Biến lưu thông tin dòng tiến trình được chọn
    ps_line=$(ps -ef | fzf "${fzf_style[@]}" \
      --header="[Enter] SIGTERM (Kill) | [Ctrl-X] SIGKILL (Buộc dừng) | [Ctrl-R] Tải lại" \
      --prompt="$i_jobs  Kill Process > " \
      --preview="ps -p {2} -o pid,ppid,%cpu,%mem,stat,start,time,command --width 100 2>/dev/null || ps -p {2} -f" \
      --preview-window="down:5:wrap" \
      --expect=ctrl-x \
      --bind="ctrl-r:reload(ps -ef)")
      # Liệt kê tiến trình hệ thống, cho phép xem trước thông số chi tiết tiến trình (CPU, RAM, command) và bắt phím Ctrl-X
      
    if [[ -n "$ps_line" ]]; then
      local key=$(echo "$ps_line" | head -n 1)      # Phím chức năng được nhấn (ctrl-x nếu có)
      local selected=$(echo "$ps_line" | tail -n +2) # Dòng thông tin tiến trình được chọn
      
      if [[ -n "$selected" ]]; then
        local pid=$(echo "$selected" | awk '{print $2}') # Trích xuất ID tiến trình (PID) từ cột thứ hai
        if [[ -n "$pid" ]]; then
          local sig="15"                              # Mặc định là tín hiệu 15 (SIGTERM - Dừng lịch sự)
          local sig_name="SIGTERM (Dừng lịch sự)"     # Tên của tín hiệu hiển thị cảnh báo
          if [[ "$key" == "ctrl-x" ]]; then
            sig="9"                                   # Nếu bấm Ctrl-X, dùng tín hiệu 9 (SIGKILL - Buộc dừng ngay)
            sig_name="SIGKILL (Buộc dừng ngay)"
          fi
          
          print -P "%F{yellow}[WARN]%f Bạn có chắc muốn gửi tín hiệu $sig_name đến PID $pid? (y/N)" # Hỏi lại người dùng trước khi kill
          read -q "confirm?"                          # Đọc một ký tự xác nhận
          echo ""                                     # Xuống dòng cho đẹp
          if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
            kill -$sig "$pid" && print -P "%F{green}[OK]%f Đã dừng tiến trình $pid." || print -P "%F{red}[ERROR]%f Không thể dừng tiến trình $pid."
            # Thực hiện lệnh kill tiến trình và thông báo kết quả tương ứng
          fi
        fi
      fi
    fi
  }

  # Xử lý các tham số dòng lệnh đầu vào để kích hoạt chế độ tương ứng
  case "$mode" in
    -d|d|cd)
      _f_mode_dir "$start_path"       # Chế độ tìm & cd thư mục
      ;;
    -f|f|file|open)
      _f_mode_file "$start_path"      # Chế độ tìm & mở tệp tin
      ;;
    -c|c|content|rg)
      _f_mode_content "$start_path"   # Chế độ tìm nội dung trong tệp
      ;;
    -h|h|history)
      _f_mode_history                 # Chế độ tra lịch sử lệnh
      ;;
    -p|p|process|kill)
      _f_mode_process                 # Chế độ quản lý & tắt tiến trình
      ;;
    --help|help)
      # Hiển thị bảng hướng dẫn sử dụng chi tiết bằng chữ màu Cyber Pastel
      print -P "%F{#00FFDD}⌨️  Bộ công cụ tìm kiếm tối thượng (Ultimate Search Tool - f)%f"
      print -P "Cách dùng: %F{#FFCCFF}f [chế độ] [đường dẫn]%f"
      print -P "Các chế độ khả dụng:"
      print -P "  %F{#00FFDD}-d, d, cd%f        Tìm thư mục & di chuyển vào (cd)"
      print -P "  %F{#00FFDD}-f, f, file%f      Tìm tệp tin & mở bằng trình biên soạn (open)"
      print -P "  %F{#00FFDD}-c, c, content%f   Tìm nội dung trong tệp bằng ripgrep (Live rg)"
      print -P "  %F{#00FFDD}-h, h, history%f   Tìm kiếm & chèn lệnh từ lịch sử (history)"
      print -P "  %F{#00FFDD}-p, p, process%f   Quản lý tiến trình đang chạy (kill)"
      print -P "Nếu không truyền tham số hoặc nhập sai, menu FZF sẽ tự động hiển thị để bạn chọn chế độ."
      ;;
    *)
      # Nếu truyền tham số không khớp, hoặc không truyền, hiển thị menu lựa chọn nhanh bằng FZF
      if ! (( $+commands[fzf] )); then
        print -P "%F{red}[ERROR]%f Lỗi: Hệ thống chưa cài đặt 'fzf'!" # Báo lỗi thiếu fzf
        return 1
      fi
      
      local choice                    # Biến chứa dòng lựa chọn từ menu FZF
      choice=$(echo -e "$i_dir 1. Thư mục (cd)\n$i_file 2. Tệp tin (open)\n$i_search 3. Nội dung tệp (ripgrep)\n$i_history 4. Lịch sử lệnh (history)\n$i_jobs 5. Tiến trình (kill)" | \
               fzf "${fzf_style[@]}" \
                   --prompt="$i_search  Chọn chế độ tìm kiếm > " \
                   --header="Dùng mũi tên và Enter để chọn chế độ" \
                   --height=15)       # Hiển thị danh sách 5 chế độ kèm icon động thông minh
               
      case "$choice" in
        *1.*) _f_mode_dir "$mode" ;;   # Kích hoạt chế độ tìm thư mục
        *2.*) _f_mode_file "$mode" ;;  # Kích hoạt chế độ tìm tệp tin
        *3.*) _f_mode_content "$mode" ;; # Kích hoạt chế độ tìm kiếm nội dung
        *4.*) _f_mode_history ;;       # Kích hoạt chế độ tra lịch sử
        *5.*) _f_mode_process ;;       # Kích hoạt chế độ tắt tiến trình
      esac
      ;;
  esac
}

