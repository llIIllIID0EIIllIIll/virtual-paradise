  I_PHP="[PHP]"
  I_CPP="[C++]"
  I_HTML="[HTML]"
  I_KUBE="[KUBE]"
  I_TF="[TF]"

  # Hàm thiết lập I_OS với tên chữ thường hoặc viết tắt
  function () {
    local os_type=$(uname -s)
    if [[ "$os_type" == "Darwin" ]]; then
      I_OS="[OS]"
      ZSH_HUD_OS_ID="darwin"
    elif [[ "$os_type" == *"MINGW"* || "$os_type" == *"MSYS"* || "$os_type" == *"CYGWIN"* ]]; then
      I_OS="[OS]"
      ZSH_HUD_OS_ID="windows"
    else
      if [[ -f /etc/os-release ]]; then
        local line os_id os_like
        while IFS= read -r line; do
          if [[ "$line" =~ ^ID= ]]; then
            os_id="${line#*=}"
            os_id="${os_id//\"/}"
          elif [[ "$line" =~ ^ID_LIKE= ]]; then
            os_like="${line#*=}"
            os_like="${os_like//\"/}"
          fi
        done < /etc/os-release

        if [[ "$os_id" == "ubuntu" || "$os_like" == *"ubuntu"* ]]; then
          I_OS="[OS]"
          ZSH_HUD_OS_ID="ubuntu"
        elif [[ "$os_id" == "debian" || "$os_like" == *"debian"* ]]; then
          I_OS="[OS]"
          ZSH_HUD_OS_ID="debian"
        elif [[ "$os_id" == "arch" || "$os_like" == *"arch"* ]]; then
          I_OS="[OS]"
          ZSH_HUD_OS_ID="arch"
        elif [[ "$os_id" == "fedora" ]]; then
          I_OS="[OS]"
          ZSH_HUD_OS_ID="fedora"
        elif [[ "$os_id" == "centos" ]]; then
          I_OS="[OS]"
          ZSH_HUD_OS_ID="centos"
        elif [[ "$os_id" == "alpine" ]]; then
          I_OS="[OS]"
          ZSH_HUD_OS_ID="alpine"
        else
          I_OS="[OS]"
          ZSH_HUD_OS_ID="linux"
        fi
      else
        I_OS="[OS]"
        ZSH_HUD_OS_ID="linux"
      fi
    fi
  }
fi

