# Helper: Detect preferred editor (User-friendly / Easiest first -> Modal/Vim last)
_f_detect_editor() {
  if [[ -n "$ZSH_F_EDITOR" ]] && (( $+commands[$ZSH_F_EDITOR] )); then
    echo "$ZSH_F_EDITOR"
    return
  fi
  # Priority: micro (intuitive Ctrl-C/V/S) -> nano (easy) -> code -> helix -> nvim -> vim -> vi
  for cand in micro nano code codium helix hx nvim vim vi; do
    if (( $+commands[$cand] )); then
      echo "$cand"
      return
    fi
  done
  local ed="${EDITOR:-${VISUAL:-vi}}"
  echo "$ed"
}

# Helper: Open files in detected editor
_f_open_files() {
  local files=(${(f)1})
  [[ ${#files} -eq 0 ]] && return

  local editor="$(_f_detect_editor)"
  case "$editor" in
    micro|nano)
      $editor "${files[@]}"
      ;;
    code|codium)
      $editor "${files[@]}"
      ;;
    nvim|vim|vi)
      $editor -p "${files[@]}"
      ;;
    *)
      $editor "${files[@]}"
      ;;
  esac
}

# Helper: Open single file jumping to specific line number
_f_open_in_editor() {
  local file="$1"
  local line="${2:-}"
  local editor="$(_f_detect_editor)"

  if [[ -n "$line" ]]; then
    case "$editor" in
      micro|hx|helix)
        $editor "$file:$line"
        ;;
      nano)
        nano "+${line}" "$file"
        ;;
      code|codium)
        $editor -g "$file:$line"
        ;;
      nvim|vim|vi)
        $editor "+${line}" "$file"
        ;;
      *)
        $editor "$file"
        ;;
    esac
  else
    $editor "$file"
  fi
}

# Sub-mode: Directory Navigator (cd)
_f_mode_dir() {
  local fd_bin=""
  (( $+commands[fd] )) && fd_bin="fd" || { (( $+commands[fdfind] )) && fd_bin="fdfind"; }
  if [[ -z "$fd_bin" ]]; then
    print -P "%F{#ff0055}[ERROR]%f 'fd' / 'fd-find' is required for directory navigation."
    return 1
  fi

  local current_dir="$(realpath "${1:-.}")"
  while true; do
    local fzf_out
    fzf_out=$(command $fd_bin -t d -H -E .git -E node_modules -E .cache -E target -E .venv "" "$current_dir" 2>/dev/null | \
              fzf "${_FZF_PARADISE_STYLE[@]}" \
                  --expect=left,right \
                  --prompt="  Directory: $current_dir > " \
                  --header="[Enter] CD into | [←] Parent | [→] Subdirectory | [Ctrl-/] Preview" \
                  --preview="(eza --tree --level=2 --color=always --icons {} || tree -C -L 2 {} || ls -lhA --color=always {}) 2>/dev/null | head -50" \
                  --preview-window="right:60%,border-left:<80(down:50%,border-top)")

    local status=$?
    [[ $status -eq 130 || -z "$fzf_out" ]] && break

    local key="$(echo "$fzf_out" | head -n 1)"
    local selected="$(echo "$fzf_out" | tail -n +2)"

    if [[ "$key" == "left" ]]; then
      current_dir="$(dirname "$current_dir")"
    elif [[ "$key" == "right" && -n "$selected" ]]; then
      current_dir="$selected"
    else
      [[ -n "$selected" ]] && cd "$selected"
      break
    fi
  done
}

# Sub-mode: File Finder (open in editor)
_f_mode_file() {
  local fd_bin=""
  (( $+commands[fd] )) && fd_bin="fd" || { (( $+commands[fdfind] )) && fd_bin="fdfind"; }
  if [[ -z "$fd_bin" ]]; then
    print -P "%F{#ff0055}[ERROR]%f 'fd' / 'fd-find' is required for file search."
    return 1
  fi

  local bat_bin=""
  (( $+commands[bat] )) && bat_bin="bat" || { (( $+commands[batcat] )) && bat_bin="batcat"; }

  local current_dir="$(realpath "${1:-.}")"
  while true; do
    local fzf_out
    fzf_out=$(command $fd_bin -t f -H -E .git -E node_modules -E .cache -E target -E .venv "" "$current_dir" 2>/dev/null | \
              fzf "${_FZF_PARADISE_STYLE[@]}" \
                  --multi \
                  --expect=left \
                  --prompt="󰈙  Files: $current_dir > " \
                  --header="[Tab] Multi-select | [Enter] Open in Editor | [←] Parent | [Ctrl-/] Preview" \
                  --preview="(${bat_bin:-cat} --style=numbers --color=always --line-range :120 {} || cat {}) 2>/dev/null | head -120" \
                  --preview-window="right:60%,border-left:<80(down:50%,border-top)")

    local status=$?
    [[ $status -eq 130 || -z "$fzf_out" ]] && break

    local key="$(echo "$fzf_out" | head -n 1)"
    local selected="$(echo "$fzf_out" | tail -n +2)"

    if [[ "$key" == "left" ]]; then
      current_dir="$(dirname "$current_dir")"
    else
      _f_open_files "$selected"
      break
    fi
  done
}

# Sub-mode: Live Ripgrep Content Search
_f_mode_content() {
  if ! (( $+commands[rg] )); then
    print -P "%F{#ff0055}[ERROR]%f 'ripgrep' (rg) is required for content search."
    return 1
  fi

  local bat_bin=""
  (( $+commands[bat] )) && bat_bin="bat" || { (( $+commands[batcat] )) && bat_bin="batcat"; }

  local search_path="${1:-.}"
  local result

  result=$(FZF_DEFAULT_COMMAND="rg --column --line-number --no-heading --color=always --smart-case --glob '!.git' --glob '!node_modules' --glob '!target' --glob '!.venv' '' \"$search_path\"" \
    fzf "${_FZF_PARADISE_STYLE[@]}" \
        --ansi \
        --disabled \
        --delimiter=: \
        --prompt="  Ripgrep ($search_path) > " \
        --header="[Enter] Open in Editor at matched line | [Ctrl-/] Preview" \
        --bind "change:reload(rg --column --line-number --no-heading --color=always --smart-case --glob '!.git' --glob '!node_modules' --glob '!target' --glob '!.venv' {q} \"$search_path\" || true)" \
        --preview="(${bat_bin:-cat} --style=numbers --color=always --highlight-line {2} {1} 2>/dev/null || cat {1} 2>/dev/null)" \
        --preview-window="right:60%,border-left:<80(down:50%,border-top),+{2}-/2")

  if [[ -n "$result" ]]; then
    local file="$(echo "$result" | cut -d':' -f1)"
    local line="$(echo "$result" | cut -d':' -f2)"
    _f_open_in_editor "$file" "$line"
  fi
}

# Sub-mode: Git Modified / Untracked Files Browser
_f_mode_git() {
  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    print -P "%F{#ff0055}[ERROR]%f Not inside a git repository."
    return 1
  fi

  local bat_bin=""
  (( $+commands[bat] )) && bat_bin="bat" || { (( $+commands[batcat] )) && bat_bin="batcat"; }

  local selected
  selected=$(git status --short | \
    fzf "${_FZF_PARADISE_STYLE[@]}" \
        --multi \
        --prompt="󰊢  Git Changed Files > " \
        --header="[Tab] Multi-select | [Enter] Open in Editor | [Ctrl-/] Preview" \
        --preview="f={2}; (git diff --color=always -- \"\$f\" 2>/dev/null; if [[ \$(git status --porcelain -- \"\$f\" 2>/dev/null | cut -c1-2) == *\"?\"* ]]; then (${bat_bin:-cat} --style=numbers --color=always \"\$f\" 2>/dev/null || cat \"\$f\" 2>/dev/null); fi) | head -120" \
        --preview-window="right:60%,border-left:<80(down:50%,border-top)")

  if [[ -n "$selected" ]]; then
    local files=()
    while IFS= read -r line; do
      local f="$(echo "$line" | awk '{print $NF}')"
      [[ -n "$f" && -f "$f" ]] && files+=("$f")
    done <<< "$selected"
    _f_open_files "${(F)files}"
  fi
}

# Sub-mode: Command History Search & Insertion
_f_mode_history() {
  local cmd
  cmd=$(fc -rln 1 2>/dev/null | awk '!seen[$0]++' | \
    fzf "${_FZF_PARADISE_STYLE[@]}" \
        --prompt="  Command History > " \
        --header="[Enter] Insert command into prompt buffer" \
        --preview="echo {}" \
        --preview-window="down:3:wrap")

  [[ -n "$cmd" ]] && print -z "$cmd"
}

# Sub-mode: Interactive Process Manager
_f_mode_process() {
  local ps_line
  ps_line=$(ps -eo user,pid,ppid,%cpu,%mem,stat,start,time,comm --sort=-%cpu | \
    fzf "${_FZF_PARADISE_STYLE[@]}" \
        --header="[Enter] SIGTERM (15) | [Ctrl-X] SIGKILL (9) | [Ctrl-R] Reload | [Ctrl-U] Only $USER" \
        --prompt="  Kill Process > " \
        --preview="ps -p {2} -o pid,ppid,user,%cpu,%mem,stat,start,time,command --width 120 2>/dev/null || ps -p {2} -f" \
        --preview-window="down:5:wrap" \
        --expect=ctrl-x \
        --bind="ctrl-r:reload(ps -eo user,pid,ppid,%cpu,%mem,stat,start,time,comm --sort=-%cpu)" \
        --bind="ctrl-u:reload(ps -u \"$USER\" -o user,pid,ppid,%cpu,%mem,stat,start,time,comm --sort=-%cpu)")

  if [[ -n "$ps_line" ]]; then
    local key="$(echo "$ps_line" | head -n 1)"
    local selected="$(echo "$ps_line" | tail -n +2)"

    if [[ -n "$selected" ]]; then
      local pid="$(echo "$selected" | awk '{print $2}')"
      if [[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]]; then
        local sig="15"
        local sig_name="SIGTERM (Graceful Terminate)"
        if [[ "$key" == "ctrl-x" ]]; then
          sig="9"
          sig_name="SIGKILL (Force Kill)"
        fi

        print -P "%F{#ffb7d5}[WARN]%f Are you sure you want to send %F{#00f5d4}$sig_name%f to PID %F{#00ff88}$pid%f? (y/N)"
        read -q "confirm?"
        echo ""
        if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
          if kill -$sig "$pid" 2>/dev/null; then
            print -P "%F{#00ff88}[OK]%f Process PID $pid terminated successfully."
          else
            print -P "%F{#ff0055}[ERROR]%f Failed to terminate PID $pid (Permission denied or process exited)."
          fi
        fi
      fi
    fi
  fi
}

# Main Dispatcher Function
function f() {
  local mode="$1"
  local start_path="${2:-.}"

  case "$mode" in
    -d|d|cd)
      _f_mode_dir "$start_path"
      ;;
    -f|f|file|open)
      _f_mode_file "$start_path"
      ;;
    -c|c|content|rg)
      _f_mode_content "$start_path"
      ;;
    -g|g|git)
      _f_mode_git
      ;;
    -h|h|history)
      _f_mode_history
      ;;
    -p|p|process|kill)
      _f_mode_process
      ;;
    --help|help)
      print -P "%F{#00f5d4}⌨️  Ultimate Interactive Search & Action Hub (f)%f"
      print -P "Usage: %F{#eafbfa}f [mode] [path]%f"
      print -P "Available Modes:"
      print -P "  %F{#00f5d4}-d, d, cd%f        Search directories & cd into (interactive [←/→])"
      print -P "  %F{#00f5d4}-f, f, file%f      Search files & open in editor (multi-select [Tab])"
      print -P "  %F{#00f5d4}-c, c, content%f   Search file contents via live ripgrep"
      print -P "  %F{#00f5d4}-g, g, git%f       Browse git modified/untracked files with diff preview"
      print -P "  %F{#00f5d4}-h, h, history%f   Search & insert command from deduplicated history"
      print -P "  %F{#00f5d4}-p, p, process%f   Manage & terminate active processes ([Enter]/[Ctrl-X])"
      print -P "If called without arguments, an interactive FZF menu is displayed."
      ;;
    *)
      if ! (( $+commands[fzf] )); then
        print -P "%F{#ff0055}[ERROR]%f 'fzf' is not installed on this system!"
        return 1
      fi

      local choice
      choice=$(echo -e " 1. Directories (cd)\n󰈙 2. Files (open in editor)\n 3. Content Search (live ripgrep)\n󰊢 4. Git Modified Files (diff preview)\n 5. Command History (search & insert)\n 6. Process Manager (kill)" | \
               fzf "${_FZF_PARADISE_STYLE[@]}" \
                   --prompt="  Select Search Mode > " \
                   --header="[Enter] Choose mode | [ESC] Exit" \
                   --height=16)

      case "$choice" in
        *1.*) _f_mode_dir "$mode" ;;
        *2.*) _f_mode_file "$mode" ;;
        *3.*) _f_mode_content "$mode" ;;
        *4.*) _f_mode_git ;;
        *5.*) _f_mode_history ;;
        *6.*) _f_mode_process ;;
      esac
      ;;
  esac
}

