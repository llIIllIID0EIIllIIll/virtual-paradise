  else
    temp_icon="$I_TEMP_CRIT"       # Critical / Overheating (>= 75°C)
    temp_color="${C_ALERT}"         # Neon Coral Red
  fi

  REPLY="${temp_color}${temp_icon} ${C_DATA}${temp}°C"
}

