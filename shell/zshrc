  REPLY="$parts"
}

# Module G: Real-time Memory Usage Monitor (< 0.1ms via /proc/meminfo)
# Reads /proc/meminfo directly using Zsh file redirection (0 external forks)
# Achieves sub-millisecond parsing speed
function zsh_mem_info() {
  REPLY=""
  local meminfo
  if [[ -f /proc/meminfo ]]; then
    meminfo=$(</proc/meminfo)
    local total avail
    if [[ "$meminfo" =~ $'[[:space:]]*MemTotal:[[:space:]]*([0-9]+)' ]]; then
      total=$match[1]
    fi
    if [[ "$meminfo" =~ $'[[:space:]]*MemAvailable:[[:space:]]*([0-9]+)' ]]; then
      avail=$match[1]
    fi
    
    if [[ -n $total && -n $avail ]]; then
      local used=$(( total - avail ))
      local mem_pct=$(( (used * 100) / total ))
      local total_gb=$(printf "%.1f" $(( total / 1024.0 / 1024.0 )))
      local used_gb=$(printf "%.1f" $(( used / 1024.0 / 1024.0 )))
      
      local ram_icon="$I_RAM_LOW"
      local ram_color="${C_ACCENT}"
      
      if (( mem_pct < 50 )); then
        ram_icon="$I_RAM_LOW"
        ram_color="${C_ACCENT}"
      elif (( mem_pct < 80 )); then
        ram_icon="$I_RAM_MID"
        ram_color="%F{#FFD43B}"
      else
        ram_icon="$I_RAM_HIGH"
        ram_color="${C_ALERT}"
      fi
      
      REPLY="${ram_color}${ram_icon} ${C_DATA}${used_gb}/${total_gb}G(${mem_pct}%%)"
    fi
  fi
}

# Module G2: CPU / GPU Temperature Sensor
# Reads Linux sysfs thermal zones or caches nvidia-smi values
function zsh_get_temp() {
  REPLY=0
  local status_file="${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_temp_status"
  if [[ -f "$status_file" ]]; then
    local temp=$(<"$status_file")
    if [[ -n "$temp" && "$temp" -gt 0 ]]; then
      REPLY="$temp"
    fi
  fi
}

function zsh_temp_info() {
  REPLY=""
  zsh_get_temp
  local temp=$REPLY
  if [[ -z "$temp" || "$temp" -eq 0 ]]; then
    REPLY=""
    return
  fi

  local temp_icon="$I_TEMP_COLD"
  local temp_color="${C_ACCENT}"

  # Dynamically adjust icon and color based on temperature thresholds
  if (( temp < 45 )); then
    temp_icon="$I_TEMP_COLD"       # Cold / Optimal (< 45°C)
    temp_color="${C_ACCENT}"
  elif (( temp < 60 )); then
    temp_icon="$I_TEMP_WARM"       # Warm (45 - 59°C)
    temp_color="%F{#8CC84B}"        # Pastel Green
  elif (( temp < 75 )); then
    temp_icon="$I_TEMP_HOT"        # Hot (60 - 74°C)
