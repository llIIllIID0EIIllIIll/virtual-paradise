# [1] mkcd: Tạo một thư mục mới và tự động di chuyển (cd) ngay lập tức vào đó.
# -> Cách dùng: mkcd <tên_thư_mục_hoặc_đường_dẫn>
# -> Ví dụ: mkcd src/components/auth
function mkcd() {
  # Kiểm tra xem tham số truyền vào (tên thư mục) có bị trống không
  if [ -z "$1" ]; then
    # In ra dòng cảnh báo màu vàng (%F{yellow} và tắt màu bằng %f) nếu người dùng quên nhập tên thư mục
    print -P "%F{yellow}[WARN]%f Lỗi: Vui lòng nhập tên thư mục cần tạo! (Ví dụ: mkcd dự_án_mới)"
    return 1 # Trả về mã lỗi 1 để dừng hàm
  fi
  # mkdir -p: Tạo thư mục, tự động tạo các thư mục cha nếu chưa có (Ví dụ: a/b/c)
  # && cd: Nếu tạo thư mục thành công thì lập tức di chuyển vào thư mục đó
  mkdir -p "$1" && cd "$1"
}

# [2] extract: Giải nén tự động hầu hết các định dạng file nén phổ biến hiện nay mà không cần nhớ cú pháp riêng của từng lệnh.
# -> Cách dùng: extract <tên_file_nén>
# -> Ví dụ: extract archive.tar.gz
function extract() {
  # Kiểm tra xem tệp tin truyền vào có thực sự tồn tại trong thư mục không (-f)
  if [ -f "$1" ] ; then
    # Dùng cấu trúc case-in để bắt đuôi mở rộng của tệp và gọi lệnh giải nén tương ứng
    case "$1" in
      *.tar.bz2)   tar xjf "$1"     ;; # Giải nén file .tar.bz2
      *.tar.gz)    tar xzf "$1"     ;; # Giải nén file .tar.gz
      *.tar.xz|*.txz) tar -xJf "$1" ;; # Giải nén file .tar.xz
      *.tar.zst|*.tar.zstd) tar --zstd -xf "$1" ;; # Giải nén file .tar.zst
      *.bz2)       bunzip2 "$1"     ;; # Giải nén file .bz2 đơn lẻ
      *.rar)       unrar x "$1"     ;; # Giải nén file .rar (yêu cầu cài unrar)
      *.gz)        gunzip "$1"      ;; # Giải nén file .gz đơn lẻ
      *.tar)       tar xf "$1"      ;; # Giải nén file tarball .tar
      *.tbz2)      tar xjf "$1"     ;; # Giải nén file .tbz2
      *.tgz)       tar xzf "$1"     ;; # Giải nén file .tgz
      *.zip)       unzip "$1"       ;; # Giải nén file .zip (yêu cầu cài unzip)
      *.Z)         uncompress "$1"  ;; # Giải nén file nén cổ điển .Z
      *.7z)        7z x "$1"        ;; # Giải nén file .7z (yêu cầu cài p7zip)
      *)           # In thông báo màu đỏ (%F{red}) khi tệp tin có định dạng đuôi không được hỗ trợ
                   print -P "%F{red}[ERROR]%f Lỗi: '$1' không được hỗ trợ giải nén qua hàm extract" ;;
    esac
  else
    # In cảnh báo lỗi khi đường dẫn file nhập vào không tồn tại
    print -P "%F{red}[ERROR]%f Lỗi: '$1' không phải là tệp tin hợp lệ hoặc không tồn tại!"
  fi
}

# [3] weather: Xem nhanh dự báo thời tiết trực quan của bất kỳ thành phố nào trên thế giới thông qua dịch vụ wttr.in.
# -> Cách dùng: weather [tên_thành_phố_tiếng_anh] (Mặc định sẽ lấy Hồ Chí Minh nếu để trống)
# -> Ví dụ: weather Ho Chi Minh
function weather() {
  # Gán biến city bằng tham số thứ nhất truyền vào ($1). Nếu trống, mặc định lấy giá trị "Ho Chi Minh"
  local city="${1:-Ho Chi Minh}"
  # Gửi yêu cầu HTTP GET đến wttr.in, thêm tham số ?m để hiển thị đơn vị đo chuẩn mét (độ C, km/h) thay vì độ F của Mỹ
  # Thiết lập timeout 5 giây để tránh treo terminal khi mất mạng
  curl -sS --max-time 5 "https://wttr.in/${city}?m"
