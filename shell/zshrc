function zsh_make_pill() {
  local bg="$1"
  local fg="$2"
  local content="$3"
  if [[ -z "$content" ]]; then
    REPLY=""
    return
  fi
  REPLY="%F{${bg}}${ZSH_HUD_L_CAP}%K{${bg}}%F{${fg}} ${content} %k%F{${bg}}${ZSH_HUD_R_CAP}%f"
}

# Helper to interpolate between two hex colors
# $1: start color (Hex, e.g. #00FFDD or 00FFDD)
# $2: end color (Hex, e.g. #FFCCFF or FFCCFF)
# $3: current step (1-based index)
# $4: total steps
# Returns hex color via REPLY
function zsh_interpolate_color() {
  local hex1="${1#\#}"
  local hex2="${2#\#}"
  local -i step="$3"
  local -i total="$4"
  
  if (( total <= 1 )); then
    REPLY="#${hex1}"
    return
  fi
  
  local -i r1=$(( 16#${hex1[1,2]} ))
  local -i g1=$(( 16#${hex1[3,4]} ))
  local -i b1=$(( 16#${hex1[5,6]} ))
  
  local -i r2=$(( 16#${hex2[1,2]} ))
  local -i g2=$(( 16#${hex2[3,4]} ))
  local -i b2=$(( 16#${hex2[5,6]} ))
  
  local -F ratio=$(( (step - 1.0) / (total - 1.0) ))
  local -i r=$(( r1 + (r2 - r1) * ratio ))
  local -i g=$(( g1 + (g2 - g1) * ratio ))
  local -i b=$(( b1 + (b2 - b1) * ratio ))
  
  printf -v REPLY "#%02x%02x%02x" $r $g $b
}

# Helper to generate pill capsule with background gradient
# $1: start bg color (Hex, e.g. #00FFDD)
# $2: end bg color (Hex, e.g. #FFCCFF)
# $3: text color (Hex, e.g. #11111b)
# $4: content text
# Returns capsule string via REPLY
function zsh_make_gradient_pill() {
  local bg_start="$1"
  local bg_end="$2"
  local fg="$3"
  local content="$4"
  
  if [[ -z "$content" ]]; then
    REPLY=""
    return
  fi
  
  local full_text=" ${content} "
  local -i len=${#full_text}
  local result="%F{${bg_start}}${ZSH_HUD_L_CAP}%f"
  
  local i char color
  for (( i = 1; i <= len; i++ )); do
    char="${full_text[i]}"
    zsh_interpolate_color "$bg_start" "$bg_end" "$i" "$len"
    color="$REPLY"
    result+="%K{${color}}%F{${fg}}${char}"
  done
  
  result+="%k%F{${bg_end}}${ZSH_HUD_R_CAP}%f"
  REPLY="$result"
}

# Module B: User & Session Info (Virtual☆Paradise theme)
function zsh_user_info() {
  local icon name bg fg
  # UID 0 indicates Root / Superuser session
  if [[ $UID -eq 0 ]]; then
    icon="$I_ROOT"
    name="ROOT"
    bg="$BG_ROOT"
    fg="$FG_ROOT"
  # SSH_CONNECTION indicates remote session
  elif [[ -n $SSH_CONNECTION ]]; then
    icon="$I_SSH"
    name="%n@%m"
    bg="$BG_SSH"
    fg="$FG_SSH"
  # Standard local user session
  else
    icon="$I_USER"
    name="%n"
    bg="$BG_USER"
    fg="$FG_USER"
