  *":$PNPM_HOME:"*) ;; # Nếu biến PNPM_HOME đã nằm trong danh sách tìm kiếm PATH rồi thì bỏ qua
  *) export PATH="$PNPM_HOME:$PATH" ;; # Nếu chưa có, đẩy đường dẫn PNPM_HOME lên đầu tiên của PATH
esac

# Tạo biệt danh để gọi nhanh các công cụ AI coding assistant đã cài đặt trong hệ thống
alias gemini='$HOME/.local/share/pnpm/gemini' # gemini: Khởi chạy Gemini CLI (trợ lý AI của Google) từ thư mục pnpm global
alias agy='$HOME/.local/bin/agy'              # agy: Khởi chạy Antigravity IDE Agent (trợ lý AI coding) từ thư mục cài đặt local

# =========================================================================
# ⚙️ CẤU HÌNH ĐƯỜNG DẪN SNAP (CHO CÁC GÓI CÀI ĐẶT QUA SNAP NHƯ YAZI)
# =========================================================================
# Thêm /snap/bin vào PATH nếu thư mục tồn tại và chưa được khai báo (quan trọng trên Ubuntu/Debian)
if [[ -d /snap/bin ]]; then
  case ":$PATH:" in
    *":/snap/bin:"*) ;;
    *) export PATH="$PATH:/snap/bin" ;;
  esac
fi

# =========================================================================
# ⚙️ CẤU HÌNH CHO FNM (FAST NODE MANAGER - TRÌNH QUẢN LÝ PHIÊN BẢN NODEJS CỰC NHANH)
# =========================================================================
FNM_PATH="$HOME/.local/share/fnm"
# Nếu thư mục cài đặt FNM thực sự tồn tại
if [ -d "$FNM_PATH" ]; then
  if [[ -z "$_ZSHRC_INITIALIZED" ]]; then
    # Thêm đường dẫn FNM vào biến PATH để có thể chạy lệnh fnm ngoài terminal
    export PATH="$FNM_PATH:$PATH"
    
    # Khởi tạo FNM tích hợp vào Zsh:
    # --use-on-cd: Tự động chuyển đổi phiên bản Node.js phù hợp khi bạn di chuyển vào thư mục chứa file .node-version hoặc .nvmrc
    # --version-file-strategy=recursive: Tìm kiếm file cấu hình Node.js đệ quy ngược lên thư mục cha
    # --corepack-enabled: Tự động kích hoạt công cụ Corepack của NodeJS
    eval "$(fnm env --use-on-cd --version-file-strategy=recursive --corepack-enabled --resolve-engines --shell zsh)"
    
    # Kỹ thuật Tối ưu hóa hiệu suất (Performance Best Practice):
    # Việc sinh mã tự động gợi ý lệnh (completions) của FNM mỗi lần mở terminal rất mất thời gian.
    # Giải pháp: Lưu đệm (cache) kết quả gợi ý lệnh vào file fnm_completions.zsh.
    local FNM_COMP_FILE="${ZSH_CACHE_DIR:-$HOME/.cache}/fnm_completions.zsh"
    local FNM_BIN=$(whence -p fnm)
    # Tự động tạo lại cache nếu chưa có hoặc nếu file chạy fnm mới hơn file cache
    if [[ ! -f "$FNM_COMP_FILE" || ( -n "$FNM_BIN" && "$FNM_BIN" -nt "$FNM_COMP_FILE" ) ]]; then
      mkdir -p "$(dirname "$FNM_COMP_FILE")"
      # Gọi lệnh sinh gợi ý của FNM và lưu đè vào file cache
      fnm completions --shell zsh >| "$FNM_COMP_FILE" 2>/dev/null
    fi
    # Nạp nội dung gợi ý lệnh từ file cache (tốc độ đọc cực nhanh)
    [[ -f "$FNM_COMP_FILE" ]] && source "$FNM_COMP_FILE"
  fi
fi



# =========================================================================
# 🚀 AUTOMATIC COMPILATION FOR STARTUP SPEEDUP (TỰ ĐỘNG BIÊN DỊCH TĂNG TỐC LOAD SHELL)
# =========================================================================
# Kỹ thuật nâng cao: Mỗi khi bạn mở một tab Terminal mới, Zsh phải đọc và phân tích toàn bộ file văn bản .zshrc này.
# Bằng cách biên dịch nó thành mã nhị phân .zwc (Zsh Word Code), Zsh có thể nạp trực tiếp file nhị phân này với tốc độ nhanh gấp 2-3 lần.

function _zsh_recompile() {
  local zconf="$HOME/.zshrc"
  # Nếu tệp tin cấu hình .zshrc mới hơn (-nt - newer than) tệp tin nhị phân đã biên dịch .zshrc.zwc
  # (Tức là bạn vừa mới chỉnh sửa nội dung file .zshrc)
  if [[ "$zconf" -nt "${zconf}.zwc" ]]; then
    # Tiến hành biên dịch lại file cấu hình sang định dạng nhị phân .zwc
    zcompile "$zconf" 2>/dev/null
  fi
}
# Chạy ngầm hàm tự động biên dịch
_zsh_recompile

if [[ -z "$_ZSHRC_INITIALIZED" ]]; then
  # Nạp biến môi trường từ script env do uv tự động tạo (nếu có)
  [[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

  # Kỹ thuật Tối ưu hóa hiệu suất (Performance Best Practice):
  # Việc sinh mã tự động gợi ý lệnh (completions) của uv và uvx mỗi lần mở terminal rất mất thời gian.
  # Giải pháp: Lưu đệm (cache) kết quả gợi ý lệnh vào file uv_completions.zsh và uvx_completions.zsh.
  if (( $+commands[uv] )); then
    local UV_COMP_FILE="${ZSH_CACHE_DIR:-$HOME/.cache}/uv_completions.zsh"
    local UV_BIN=$(whence -p uv)
    # Tự động tạo lại cache nếu chưa có hoặc nếu file chạy uv mới hơn file cache
    if [[ ! -f "$UV_COMP_FILE" || ( -n "$UV_BIN" && "$UV_BIN" -nt "$UV_COMP_FILE" ) ]]; then
      mkdir -p "$(dirname "$UV_COMP_FILE")"
      uv generate-shell-completion zsh >| "$UV_COMP_FILE" 2>/dev/null
    fi
    [[ -f "$UV_COMP_FILE" ]] && source "$UV_COMP_FILE"
  fi

  if (( $+commands[uvx] )); then
    local UVX_COMP_FILE="${ZSH_CACHE_DIR:-$HOME/.cache}/uvx_completions.zsh"
    local UVX_BIN=$(whence -p uvx)
    # Tự động tạo lại cache nếu chưa có hoặc nếu file chạy uvx mới hơn file cache
    if [[ ! -f "$UVX_COMP_FILE" || ( -n "$UVX_BIN" && "$UVX_BIN" -nt "$UVX_COMP_FILE" ) ]]; then
      mkdir -p "$(dirname "$UVX_COMP_FILE")"
      uvx --generate-shell-completion zsh >| "$UVX_COMP_FILE" 2>/dev/null
    fi
    [[ -f "$UVX_COMP_FILE" ]] && source "$UVX_COMP_FILE"
  fi
fi

# Đánh dấu shell đã được khởi tạo hoàn tất để tối ưu hóa tốc độ tải lại (source)
_ZSHRC_INITIALIZED=1

