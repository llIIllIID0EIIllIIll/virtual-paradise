# A. Module đo thời gian chạy lệnh (Exec Time)
# Hàm preexec được Zsh tự động gọi NGAY TRƯỚC KHI một câu lệnh do bạn gõ được bắt đầu chạy
function preexec() { 
  cmd_start=$EPOCHREALTIME; # Lưu thời điểm bắt đầu chạy lệnh (tính bằng giây có phần thập phân siêu chính xác)
}

# =========================================================================
# 🚨 CYBERPUNK WINDOW ERROR BORDER & GLOW HOOK (HYPRLAND)
# =========================================================================
typeset -g _omarchy_last_err_state=0

function _omarchy_error_border_hook() {
  local exit_code="$1"
  if [[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]]; then
    if [[ $exit_code -ne 0 && $_omarchy_last_err_state -eq 0 ]]; then
      _omarchy_last_err_state=1
      (~/.local/bin/hypr_window_error_shake.sh &>/dev/null &!)
    elif [[ $exit_code -eq 0 && $_omarchy_last_err_state -ne 0 ]]; then
      _omarchy_last_err_state=0
      (~/.local/bin/hypr_window_error_restore.sh &>/dev/null &!)
    fi
  fi
}

# Hàm precmd được Zsh tự động gọi NGAY TRƯỚC KHI hiển thị lại dòng Prompt nhập lệnh mới (sau khi lệnh cũ đã chạy xong)
function precmd() {
  # ĐIỀU RẤT QUAN TRỌNG: Lưu ngay mã thoát ($?) của lệnh vừa chạy xong vào biến exit_status.
  # Nếu không lưu ngay, các lệnh kiểm tra hoặc hàm phụ chạy ngầm trong Prompt sẽ ghi đè lên $? khiến kết quả hiển thị bị sai lệch.
  exit_status=$?
  _omarchy_error_border_hook "$exit_status"

  # Nếu biến thời gian bắt đầu chạy lệnh tồn tại
  if [ -n "$cmd_start" ]; then
    # Tính thời gian chạy bằng cách lấy thời điểm hiện tại trừ đi thời điểm bắt đầu
    local duration=$(($EPOCHREALTIME - $cmd_start))
    
    # Chỉ hiển thị thời gian chạy nếu câu lệnh đó chạy lâu hơn 0.5 giây (tránh làm rối mắt các lệnh chạy tích tắc)
    if (( duration > 0.5 )); then
      local formatted_time=""
      # Nếu chạy lâu hơn 1 giờ (>= 3600 giây): quy đổi ra giờ, phút, giây
      if (( duration >= 3600 )); then
        integer hours=$(( duration / 3600 ))
        integer mins=$(( (duration - hours * 3600) / 60 ))
        local secs=$(( duration - (hours * 3600) - (mins * 60) ))
        formatted_time="$(printf "%dh %dm %.1fs" $hours $mins $secs)"
      # Nếu chạy lâu hơn 1 phút (>= 60 giây): quy đổi ra phút, giây
      elif (( duration >= 60 )); then
        integer mins=$(( duration / 60 ))
        local secs=$(( duration - (mins * 60) ))
        formatted_time="$(printf "%dm %.1fs" $mins $secs)"
      # Nếu dưới 1 phút: hiển thị giây kèm 2 số phần thập phân
      else
        formatted_time="$(printf "%.2fs" $duration)"
      fi
      # Định dạng chuỗi hiển thị thời gian thực thi kèm icon tia sét và màu đỏ cảnh báo
      cmd_time="${C_ALERT}${I_EXEC} ${formatted_time}${C_DIM}${I_SEP} "
    else
      cmd_time="" # Chạy dưới 0.5s thì không hiện
    fi
    unset cmd_start # Xóa biến để chuẩn bị cho lệnh tiếp theo
  else
    cmd_time=""
  fi

  # Lưu đệm (cache) các giá trị động để hàm zsh_top_line chạy siêu nhanh (<1ms) lúc co giãn cửa sổ.
  # Kỹ thuật: Các hàm nặng (git status) chỉ chạy 1 lần ở đây trực tiếp trong shell chính (0 fork).
  # Hệ thống (RAM, Temp, Wi-Fi, Pin) đã được tối ưu hóa siêu nhanh (<0.6ms tổng cộng) nên được gọi realtime.
  # Khối quét Wi-Fi và Nhiệt độ chạy ngầm đã được tách độc lập thành tiến trình daemon ở cuối file.

  local REPLY
  zsh_user_info; _CACHE_USER_INFO="$REPLY"
  zsh_dir_info; _CACHE_DIR_INFO="$REPLY"
  zsh_git_status; _CACHE_GIT_STATUS="$REPLY"
  zsh_tool_context; _CACHE_TOOL_CONTEXT="$REPLY"
  zsh_bottom_status; _CACHE_BOTTOM_STATUS="$REPLY"

  if [[ $exit_status -eq 0 ]]; then
    _CACHE_ARROW_COLOR="${C_ACCENT}"
  else
    _CACHE_ARROW_COLOR="${C_ALERT}"
  fi

  # Thiết lập PROMPT động bằng dấu nháy đơn (single quotes) để Zsh đánh giá lại $(zsh_top_line) mỗi lần vẽ prompt.
  # Khi cửa sổ thay đổi kích thước, TRAPWINCH gọi zle reset-prompt → Zsh đánh giá lại PROMPT → zsh_top_line()
  # được gọi lại với giá trị COLUMNS mới → R_TOP tự động căn lề phải theo chiều rộng cửa sổ mới.
  # Sử dụng trực tiếp biến ${_CACHE_BOTTOM_STATUS} để loại bỏ subshell.
  PROMPT='$(zsh_top_line)
${C_DIM}${L_BOT} ${_CACHE_BOTTOM_STATUS}${_CACHE_ARROW_COLOR}${I_ARROW} ${C_RESET}'
}

# Hàm tạo khối bo tròn (pill capsule) kiểu Oh My Posh
# $1: Màu nền (Hex, vd: #1e1e2e)
# $2: Màu chữ (Hex, vd: #00FFDD)
# $3: Nội dung bên trong khối
# Biến chứa ký tự biên cho capsule (được tính toán động qua zsh_init_caps)
ZSH_HUD_L_CAP=""
ZSH_HUD_R_CAP=""

# Hàm khởi tạo hình dáng biên cho capsule dựa trên biến môi trường ZSH_PROMPT_SHAPE
function zsh_init_caps() {
  local shape="${ZSH_PROMPT_SHAPE:-round}"
  if [[ "$ZSH_HUD_NERD_MONO" == "false" ]]; then
    # Fallback khi không có Nerd Font
    ZSH_HUD_L_CAP="["
    ZSH_HUD_R_CAP="]"
    return
  fi
  
  case "$shape" in
    slant)
      ZSH_HUD_L_CAP=""
      ZSH_HUD_R_CAP=""
      ;;
    slant2)
      ZSH_HUD_L_CAP=""
      ZSH_HUD_R_CAP=""
      ;;
    pointed)
      ZSH_HUD_L_CAP=""
      ZSH_HUD_R_CAP=""
      ;;
    pixel)
      ZSH_HUD_L_CAP="░▒▓"
      ZSH_HUD_R_CAP="▓▒░"
      ;;
    fire)
      ZSH_HUD_L_CAP=""
      ZSH_HUD_R_CAP=""
      ;;
    square)
      ZSH_HUD_L_CAP="▌"
      ZSH_HUD_R_CAP="▐"
      ;;
    *) # round
      ZSH_HUD_L_CAP=""
      ZSH_HUD_R_CAP=""
      ;;
  esac
}

function zsh_make_pill() {
  local bg="$1"
  local fg="$2"
  local content="$3"
  if [[ -z "$content" ]]; then
    REPLY=""
    return
  fi
  REPLY="%F{${bg}}${ZSH_HUD_L_CAP}%K{${bg}}%F{${fg}} ${content} %k%F{${bg}}${ZSH_HUD_R_CAP}%f"
}

# Helper to interpolate between two hex colors
# $1: start color (Hex, e.g. #00FFDD or 00FFDD)
# $2: end color (Hex, e.g. #FFCCFF or FFCCFF)
# $3: current step (1-based index)
# $4: total steps
# Returns hex color via REPLY
function zsh_interpolate_color() {
  local hex1="${1#\#}"
  local hex2="${2#\#}"
  local -i step="$3"
  local -i total="$4"
  
  if (( total <= 1 )); then
    REPLY="#${hex1}"
    return
  fi
  
  local -i r1=$(( 16#${hex1[1,2]} ))
  local -i g1=$(( 16#${hex1[3,4]} ))
  local -i b1=$(( 16#${hex1[5,6]} ))
  
  local -i r2=$(( 16#${hex2[1,2]} ))
  local -i g2=$(( 16#${hex2[3,4]} ))
  local -i b2=$(( 16#${hex2[5,6]} ))
  
  local -F ratio=$(( (step - 1.0) / (total - 1.0) ))
  local -i r=$(( r1 + (r2 - r1) * ratio ))
  local -i g=$(( g1 + (g2 - g1) * ratio ))
  local -i b=$(( b1 + (b2 - b1) * ratio ))
  
  printf -v REPLY "#%02x%02x%02x" $r $g $b
}

# Helper to generate pill capsule with background gradient
# $1: start bg color (Hex, e.g. #00FFDD)
# $2: end bg color (Hex, e.g. #FFCCFF)
# $3: text color (Hex, e.g. #11111b)
# $4: content text
# Returns capsule string via REPLY
function zsh_make_gradient_pill() {
  local bg_start="$1"
  local bg_end="$2"
  local fg="$3"
  local content="$4"
  
  if [[ -z "$content" ]]; then
    REPLY=""
    return
  fi
  
  local full_text=" ${content} "
  local -i len=${#full_text}
  local result="%F{${bg_start}}${ZSH_HUD_L_CAP}%f"
  
  local i char color
  for (( i = 1; i <= len; i++ )); do
    char="${full_text[i]}"
    zsh_interpolate_color "$bg_start" "$bg_end" "$i" "$len"
    color="$REPLY"
    result+="%K{${color}}%F{${fg}}${char}"
  done
  
  result+="%k%F{${bg_end}}${ZSH_HUD_R_CAP}%f"
  REPLY="$result"
}

# B. Module hiển thị Thông tin người dùng (User Info)
function zsh_user_info() {
  local icon name bg fg
  # Nếu UID bằng 0, nghĩa là bạn đang chạy quyền Admin/ROOT tối cao
  if [[ $UID -eq 0 ]]; then
    icon="$I_ROOT"
    name="ROOT"
    bg="$BG_ROOT"
    fg="$FG_ROOT"
  # Nếu có biến môi trường SSH_CONNECTION, tức là bạn đang kết nối từ xa vào máy chủ qua SSH
  elif [[ -n $SSH_CONNECTION ]]; then
    icon="$I_SSH"
    name="%n@%m"
    bg="$BG_SSH"
    fg="$FG_SSH"
  # Trường hợp đăng nhập user bình thường trên máy cục bộ
  else
    icon="$I_USER"
    name="%n"
    bg="$BG_USER"
    fg="$FG_USER"
  fi

  if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
    local expanded_name="${(%)name}"
    if [[ $UID -eq 0 ]]; then
      zsh_make_gradient_pill "#ff0055" "#ff1744" "#ffffff" "${icon} ${expanded_name}"
    elif [[ -n $SSH_CONNECTION ]]; then
      zsh_make_gradient_pill "#8b5cf6" "#06b6d4" "#ffffff" "${icon} ${expanded_name}"
    else
      zsh_make_gradient_pill "#ffb7d5" "#00f5d4" "#07080d" "${icon} ${expanded_name}"
    fi
  else
    # Classic style
    if [[ $UID -eq 0 ]]; then
      REPLY="${C_ALERT}${I_ROOT} ROOT${C_DIM}${I_SEP} "
    elif [[ -n $SSH_CONNECTION ]]; then
      REPLY="${C_ACCENT}${I_SSH} ${C_DATA}%n@%m${C_DIM}${I_SEP} "
    else
      REPLY="${C_ACCENT}${I_USER} ${C_DATA}%n${C_DIM}${I_SEP} "
    fi
  fi
}

# C. Module hiển thị thư mục hiện hành (Directory Info)
function zsh_dir_info() {
  local lock=""
  # Kiểm tra xem thư mục hiện tại có quyền ghi hay không. Nếu không ghi được (chỉ đọc), gán icon ổ khóa màu đỏ để nhắc nhở
  [[ ! -w . ]] && lock=" ${C_ALERT}${I_LOCK}"
  
  local dir_path="%B%(3~|.../%2c|%~)%b"
  
  if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
    local lock_str=""
    [[ ! -w . ]] && lock_str=" ${I_LOCK}"
    
    local path_str="%(3~|.../%2c|%~)"
    local expanded_path="${(%)path_str}"
    if [[ ! -w . ]]; then
      zsh_make_gradient_pill "#ff0055" "#ff79a8" "#ffffff" "${I_DIR} ${expanded_path}${lock_str}"
    else
      zsh_make_gradient_pill "#00ff88" "#00f5d4" "#07080d" "${I_DIR} ${expanded_path}${lock_str}"
    fi
  else
    # Classic style
    [[ ! -w . ]] && lock=" ${C_ALERT}${I_LOCK} "
    REPLY="${C_ACCENT}${I_DIR} ${C_DATA}%B%(3~|.../%2c|%~)%b${lock}${C_DIM}${I_SEP} "
  fi
}

# D. Module hiển thị Trạng thái Git nâng cao (Git Status)
function zsh_git_status() {
  REPLY=""
  # Gọi git status một lần duy nhất với định dạng porcelain v2 và thông tin branch.
  # Nếu không phải thư mục Git, lệnh trả về lỗi và dừng hàm ngay lập tức (tiết kiệm fork).
  local gstatus
  gstatus=$(git status --porcelain=v2 --branch 2>/dev/null) || return
  
  local -a lines
  lines=(${(f)gstatus})
  
  # Lấy tên nhánh hoặc SHA ngắn nếu bị detached HEAD
  local branch_line="${(M)lines[@]:#*branch.head *}"
  local branch="${branch_line#*branch.head }"
  if [[ "$branch" == "(detached)" ]]; then
    local oid_line="${(M)lines[@]:#*branch.oid *}"
    local oid="${oid_line#*branch.oid }"
    branch="${oid[1,7]}"
  fi
  
  # Đếm các file thay đổi (staged, unstaged, untracked)
  local staged=${#${(M)lines[@]:#[12] [^.]*}}
  local unstaged=${#${(M)lines[@]:#[12] ?[^.]*}}
  local untracked=${#${(M)lines[@]:#\? *}}
  
  # Lấy thông tin ahead/behind so với upstream
  local ahead=0
  local behind=0
  local ab_line="${(M)lines[@]:#*branch.ab *}"
  if [[ -n "$ab_line" ]]; then
    local ab_vals="${ab_line#*branch.ab }"
    local -a parts
    parts=(${(s: :)ab_vals})
    ahead="${parts[1]#+}"
    behind="${parts[2]#-}"
  fi
  
  # Chuỗi hiển thị các ký hiệu thống kê:
  local git_details=""
  if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
    # Trong powerline/pill style, ta không dùng mã màu ANSI để giữ tính tương phản tốt trên nền pill
    [[ $staged -gt 0 ]] && git_details+="+${staged}"
    [[ $unstaged -gt 0 ]] && git_details+="${git_details:+ }!${unstaged}"
    [[ $untracked -gt 0 ]] && git_details+="${git_details:+ }?${untracked}"
    [[ $ahead -gt 0 ]] && git_details+="${git_details:+ }⇡${ahead}"
    [[ $behind -gt 0 ]] && git_details+="${git_details:+ }⇣${behind}"
  else
    [[ $staged -gt 0 ]] && git_details+="%F{#8CC84B}+${staged}%f"        # +: Số file đã add (màu xanh lá)
    [[ $unstaged -gt 0 ]] && git_details+="${git_details:+ }%F{#FFD43B}!${unstaged}%f" # !: Số file sửa chưa add (màu vàng)
    [[ $untracked -gt 0 ]] && git_details+="${git_details:+ }%F{#FF6070}?${untracked}%f" # ?: Số file chưa theo dõi (màu đỏ)
    [[ $ahead -gt 0 ]] && git_details+="${git_details:+ }%F{#00FFDD}⇡${ahead}%f"    # ⇡: Số commit cần push lên (màu xanh neon)
    [[ $behind -gt 0 ]] && git_details+="${git_details:+ }%F{#FF6070}⇣${behind}%f"  # ⇣: Số commit cần pull về (màu đỏ)
  fi
  
  # Hiển thị chuỗi kết quả:
  local bg fg content
  if (( staged + unstaged + untracked > 0 )); then
    bg="$BG_GIT_DIRTY"
    fg="$FG_GIT_DIRTY"
    if [[ -n "$git_details" ]]; then
      content="${I_GIT} ${branch} [${git_details}]"
    else
      content="${I_GIT} ${branch}*"
    fi
  else
    bg="$BG_GIT_CLEAN"
    fg="$FG_GIT_CLEAN"
    if [[ -n "$git_details" ]]; then
      content="${I_GIT} ${branch} [${git_details}]"
    else
      content="${I_GIT} ${branch}"
    fi
  fi

  if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
    if (( staged + unstaged + untracked > 0 )); then
      zsh_make_gradient_pill "#f38ba8" "#f9e2af" "#11111b" "$content"
    else
      zsh_make_gradient_pill "#a6e3a1" "#94e2d5" "#11111b" "$content"
    fi
  else
    # Classic style
    if (( staged + unstaged + untracked > 0 )); then
      if [[ -n "$git_details" ]]; then
        # Hiển thị nhánh màu đỏ alert kèm thông số chi tiết
        REPLY="${C_ALERT}${I_GIT} ${C_DATA}${branch}%f [${git_details}]${C_DIM}${I_SEP} "
      else
        # Nếu có thay đổi nhưng không bắt được thông số (ví dụ submodule), hiện dấu sao *
        REPLY="${C_ALERT}${I_GIT} ${C_DATA}${branch}*${C_DIM}${I_SEP} "
      fi
    else
      # Nếu thư mục hoàn toàn sạch sẽ (clean):
      if [[ -n "$git_details" ]]; then
        # Thường xảy ra khi Repo clean nhưng Ahead/Behind so với remote
        REPLY="${C_ACCENT}${I_GIT} ${C_DATA}${branch}%f [${git_details}]${C_DIM}${I_SEP} "
      else
        # Repo sạch sẽ hoàn toàn và đồng bộ hoàn hảo với server
        REPLY="${C_ACCENT}${I_GIT} ${C_DATA}${branch}${C_DIM}${I_SEP} "
      fi
    fi
  fi
}

# E. Module nhận diện ngôn ngữ lập trình & Công cụ trong thư mục hiện hành (Tools & Language Context)
# Giúp bạn nhìn ngay ra mình đang ở trong thư mục dự án gì để gõ lệnh cho đúng.
function zsh_tool_context() {
  REPLY=""
  
  if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
    local -a active_tools
    
    # 1. Nhận diện Môi trường ảo Python (Virtual Environment)
    if [[ -n $VIRTUAL_ENV ]]; then
      zsh_make_gradient_pill "#38bdf8" "#34d399" "#11111b" "${I_VENV} ${VIRTUAL_ENV:t}"
      active_tools+=("$REPLY")
    else
      local py_files=(*.py(N[1]))
      if [[ -f requirements.txt || ${#py_files} -gt 0 ]]; then
        zsh_make_gradient_pill "#3776AB" "#FFE873" "#11111b" "${I_PY} Python"
        active_tools+=("$REPLY")
      fi
    fi
    
    # 2. Nhận diện dự án JavaScript / Node.js
    local js_files=(*.js(N[1]))
