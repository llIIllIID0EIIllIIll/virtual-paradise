  I_BAT_30="[BAT]"
  I_BAT_20="[BAT]"
  I_BAT_0="[BAT]"
  I_EXEC="[EXEC]"
  I_ERR="[ERROR]"
  I_JOBS="[JOBS]"
  I_ARROW=">"
  
  I_FILE="[FILE]"
  I_SEARCH="[FIND]"

  # Các biểu tượng đại diện cho Ngôn ngữ lập trình và Công cụ
  I_PY="[PYTHON]"
  I_VENV="[VENV]"
  I_NODE="[NODE]"
  I_DOCKER="[DOCKER]"
  I_GO="[GO]"
  I_RUST="[RUST]"
