# H. Module hiển thị thông tin Pin (Battery Info)
# Đọc trạng thái pin từ các đường dẫn sysfs đã được cache lúc khởi động.
# Trên máy để bàn không có pin, hàm này sẽ tự động bỏ qua và không hiển thị gì.
function zsh_battery_info() {
  REPLY=""
  if [[ -n "$_BAT_CAPACITY_FILE" && -f "$_BAT_CAPACITY_FILE" ]]; then
    local capacity=$(<"$_BAT_CAPACITY_FILE")    # Đọc phần trăm pin (0-100)
    local bat_status=$(<"$_BAT_STATUS_FILE")    # Đọc trạng thái: Charging, Discharging, Full, Not charging
    local bat_icon="$I_BAT_100"                 # Icon pin đầy mặc định
    local bat_color="${C_ACCENT}"                # Màu mặc định (xanh neon cyan)
    
    # Kiểm tra trạng thái cắm sạc qua AC (online)
    local ac_online=0
    if [[ -n "$_AC_ONLINE_FILE" && -f "$_AC_ONLINE_FILE" ]]; then
      ac_online=$(<"$_AC_ONLINE_FILE")
    fi

      # Nếu đang sạc hoặc cắm nguồn AC (online = 1): chọn icon sạc theo mức pin và đổi màu xanh lá
      if [[ "$bat_status" == "Charging" || "$ac_online" == "1" ]]; then
        bat_color="%F{#8CC84B}"
        if [[ $capacity -ge 95 ]]; then bat_icon="$I_BAT_CHARGING_100"
        elif [[ $capacity -ge 90 ]]; then bat_icon="$I_BAT_CHARGING_90"
        elif [[ $capacity -ge 80 ]]; then bat_icon="$I_BAT_CHARGING_80"
        elif [[ $capacity -ge 70 ]]; then bat_icon="$I_BAT_CHARGING_70"
        elif [[ $capacity -ge 60 ]]; then bat_icon="$I_BAT_CHARGING_60"
        elif [[ $capacity -ge 50 ]]; then bat_icon="$I_BAT_CHARGING_50"
        elif [[ $capacity -ge 40 ]]; then bat_icon="$I_BAT_CHARGING_40"
        elif [[ $capacity -ge 30 ]]; then bat_icon="$I_BAT_CHARGING_30"
        elif [[ $capacity -ge 20 ]]; then bat_icon="$I_BAT_CHARGING_20"
        else bat_icon="$I_BAT_CHARGING_0"
        fi
      else
        # Khi không sạc: đổi màu cảnh báo theo mức pin
        if [[ $capacity -lt 20 ]]; then
          bat_color="${C_ALERT}"       # Dưới 20%: đỏ cảnh báo nguy hiểm
        elif [[ $capacity -lt 50 ]]; then
          bat_color="%F{#FFD43B}"      # Dưới 50%: vàng cảnh báo nhẹ
        fi
        
        # Chọn icon pin phù hợp với mức phần trăm (từ đầy đến cạn kiệt)
        if [[ $capacity -ge 95 ]]; then bat_icon="$I_BAT_100"       # 95-100%: Pin đầy
        elif [[ $capacity -ge 90 ]]; then bat_icon="$I_BAT_90"     # 90-94%
        elif [[ $capacity -ge 80 ]]; then bat_icon="$I_BAT_80"     # 80-89%
        elif [[ $capacity -ge 70 ]]; then bat_icon="$I_BAT_70"     # 70-79%
        elif [[ $capacity -ge 60 ]]; then bat_icon="$I_BAT_60"     # 60-69%
        elif [[ $capacity -ge 50 ]]; then bat_icon="$I_BAT_50"     # 50-59%
        elif [[ $capacity -ge 40 ]]; then bat_icon="$I_BAT_40"     # 40-49%
        elif [[ $capacity -ge 30 ]]; then bat_icon="$I_BAT_30"     # 30-39%
        elif [[ $capacity -ge 20 ]]; then bat_icon="$I_BAT_20"     # 20-29%
        else bat_icon="$I_BAT_0"                                    # 0-19%: Pin gần cạn
        fi
      fi
      
      # Xuất chuỗi kết quả: 󰁹 100% (icon + phần trăm, %% để escape ký tự % trong prompt)
      REPLY="${bat_color}${bat_icon} ${capacity}%% "
  fi
}

# H2. Module hiển thị thông tin Wi-Fi (Wi-Fi Info)
# Đọc thông tin kết nối Wi-Fi (SSID và Signal %) từ file cache tạo ra ở precmd.
# Giải pháp này tách biệt việc gọi Windows netsh.exe chậm chạp giúp Prompt vẽ tức thì trong <1ms.
function zsh_wifi_info() {
  setopt localoptions extendedglob
  REPLY=""
  local cache_file="${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_wifi_raw"
  local status_file="${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_wifi_status"
  local ssid="" signal="" rx="" tx=""
  
  if [[ -f "$cache_file" ]]; then
    local wifi_data=$(<"$cache_file")
    if [[ "$wifi_data" =~ $'[[:space:]]+SSID[[:space:]]*:[[:space:]]*([^\r\n]+)' ]]; then
      ssid="${match[1]%%[[:space:]]#}"
    fi
    if [[ "$wifi_data" =~ $'Signal[[:space:]]*:[[:space:]]*([0-9]+)%' ]]; then
      signal="$match[1]"
    fi
    if [[ "$wifi_data" =~ $'Receive rate [^:]*:[[:space:]]*([0-9]+)' ]]; then
      rx="$match[1]"
    fi
    if [[ "$wifi_data" =~ $'Transmit rate [^:]*:[[:space:]]*([0-9]+)' ]]; then
      tx="$match[1]"
    fi
  elif [[ -f "$status_file" ]]; then
    local wifi_data=$(<"$status_file")
    if [[ -n "$wifi_data" ]]; then
      local -a parts
      parts=(${(s:|:)wifi_data})
      ssid="${parts[1]}"
      signal="${parts[2]}"
    fi
  fi

  if [[ -n "$ssid" ]]; then
    local wifi_icon="$I_WIFI_FULL"
    local wifi_color="${C_ACCENT}"
    
    if [[ -n "$signal" ]]; then
      local sig_num=$(( signal ))
      if [[ $sig_num -ge 80 ]]; then
        wifi_icon="$I_WIFI_FULL"
        wifi_color="${C_ACCENT}"
      elif [[ $sig_num -ge 55 ]]; then
        wifi_icon="$I_WIFI_HIGH"
        wifi_color="${C_ACCENT}"
      elif [[ $sig_num -ge 30 ]]; then
        wifi_icon="$I_WIFI_MID"
        wifi_color="%F{#FFD43B}"
      elif [[ $sig_num -ge 10 ]]; then
        wifi_icon="$I_WIFI_LOW"
        wifi_color="${C_ALERT}"
      else
        wifi_icon="$I_WIFI_LOW"
        wifi_color="${C_ALERT}"
      fi
    fi

    local speed_str=""
    if [[ -n "$rx" && -n "$tx" ]]; then
      speed_str="(${rx}/${tx}Mbps)"
    elif [[ -n "$rx" ]]; then
      speed_str="(${rx}Mbps)"
    fi
    REPLY="${wifi_color}${wifi_icon} ${C_DATA}${ssid}${speed_str}"
  else
    REPLY="${C_ALERT}${I_WIFI_OFF} ${C_ALERT}Offline"
  fi
}

