# Defines drop-in replacements for standard Unix utilities with modern Rust/Go tools.
# Uses `(( $+commands[tool] ))` condition checks to ensure graceful fallbacks if tools are absent.
# Ensures 100% reliability across fresh or minimal installations.

# --- 1. Directory Listing (ls -> eza) ---
# Priority 1: `eza` (Modern Rust replacement with icons, git status, and tree views)
if (( $+commands[eza] )); then
  alias ls='eza --icons --git --group-directories-first'         # ls: List files with icons, git status, directories grouped first
  alias ll='eza -alF --icons --git --group-directories-first'     # ll: Detailed long list with permissions, sizes, dates, and icons
  alias la='eza -a --icons --group-directories-first'            # la: List all files including hidden dotfiles
  alias l='eza -F --icons --group-directories-first'             # l: Short list categorized by file type
  alias tree='eza --tree --icons'                                # tree: Visual tree structure with icons

# Fallback priority: alternative modern tools
elif (( $+commands[lsd] )); then
  alias ls='lsd --group-dirs first'
  alias ll='lsd -alF --group-dirs first'
  alias la='lsd -a --group-dirs first'
  alias l='lsd -F --group-dirs first'
  alias tree='lsd --tree'

# Fallback priority: standard Linux utilities
else
  alias ll='ls -alF'
  alias la='ls -A'
  alias l='ls -CF'
fi

# --- 2. Replaces legacy Unix utilities
# Replace plain `cat` with `bat` (Rust-powered syntax highlighter with line numbers)
