# F. Module trạng thái hoạt động ngầm và báo lỗi lệnh (Jobs & Error)
function zsh_bottom_status() {
  local parts=""
  # Đếm số lượng tiến trình đang chạy ngầm trong Terminal này (Background jobs) bằng biến jobstates nội tại của Zsh (0 fork)
  local jobs=${#jobstates}
  if [[ $jobs -gt 0 ]]; then
    # Hiển thị icon tiến trình ngầm kèm số lượng
    parts+="${C_ACCENT}${I_JOBS} ${C_DATA}${jobs}${C_DIM}${I_SEP} "
  fi
  
  # Kiểm tra mã lỗi của lệnh trước (exit_status lấy từ precmd).
  # Trong Linux/macOS, mã lỗi khác 0 nghĩa là lệnh chạy thất bại
  if [[ $exit_status -ne 0 ]]; then
    # Hiển thị mã lỗi màu đỏ để báo hiệu
    parts+="${C_ALERT}${I_ERR} ${exit_status}${C_DIM}${I_SEP} "
  fi
  REPLY="$parts"
}

# G. Module hiển thị thông tin RAM/SWAP (Memory Info)
# Đọc file /proc/meminfo (chỉ có trên Linux) bằng kỹ thuật Zsh file redirection ($(<file))
# thay vì gọi lệnh `free` hoặc `cat` bên ngoài để đạt tốc độ tối đa (~0.1ms thay vì ~5ms).
function zsh_mem_info() {
  REPLY=""
  local meminfo
  if [[ -f /proc/meminfo ]]; then
    meminfo=$(</proc/meminfo)
    local total avail
    if [[ "$meminfo" =~ $'[[:space:]]*MemTotal:[[:space:]]*([0-9]+)' ]]; then
      total=$match[1]
    fi
    if [[ "$meminfo" =~ $'[[:space:]]*MemAvailable:[[:space:]]*([0-9]+)' ]]; then
      avail=$match[1]
    fi
    
    if [[ -n $total && -n $avail ]]; then
      local used=$(( total - avail ))
      local mem_pct=$(( (used * 100) / total ))
      local total_gb=$(printf "%.1f" $(( total / 1024.0 / 1024.0 )))
      local used_gb=$(printf "%.1f" $(( used / 1024.0 / 1024.0 )))
      
      local ram_icon="$I_RAM_LOW"
      local ram_color="${C_ACCENT}"
      
      if (( mem_pct < 50 )); then
        ram_icon="$I_RAM_LOW"
        ram_color="${C_ACCENT}"
      elif (( mem_pct < 80 )); then
        ram_icon="$I_RAM_MID"
        ram_color="%F{#FFD43B}"
      else
        ram_icon="$I_RAM_HIGH"
        ram_color="${C_ALERT}"
      fi
      
      REPLY="${ram_color}${ram_icon} ${C_DATA}${used_gb}/${total_gb}G(${mem_pct}%%)"
    fi
  fi
}

# G2. Module hiển thị nhiệt độ CPU/GPU (Temperature Info)
# Đọc nhiệt độ từ cảm biến sysfs của Linux hoặc fallback sang nvidia-smi.
function zsh_get_temp() {
  REPLY=0
  local status_file="${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_temp_status"
  if [[ -f "$status_file" ]]; then
    local temp=$(<"$status_file")
    if [[ -n "$temp" && "$temp" -gt 0 ]]; then
      REPLY="$temp"
    fi
  fi
}

function zsh_temp_info() {
  REPLY=""
  zsh_get_temp
  local temp=$REPLY
  if [[ -z "$temp" || "$temp" -eq 0 ]]; then
    REPLY=""
    return
  fi

  local temp_icon="$I_TEMP_COLD"
  local temp_color="${C_ACCENT}"

  # Đổi biểu tượng và màu sắc theo độ nóng lạnh của máy
  if (( temp < 45 )); then
    temp_icon="$I_TEMP_COLD"       # Lạnh / Mát mẻ (< 45°C)
    temp_color="${C_ACCENT}"
  elif (( temp < 60 )); then
    temp_icon="$I_TEMP_WARM"       # Ấm áp (45 - 59°C)
    temp_color="%F{#8CC84B}"        # Xanh lá pastel
  elif (( temp < 75 )); then
    temp_icon="$I_TEMP_HOT"        # Nóng (60 - 74°C)
    temp_color="%F{#FFD43B}"        # Vàng pastel
  else
    temp_icon="$I_TEMP_CRIT"       # Rất nóng / Nguy cấp (>= 75°C)
    temp_color="${C_ALERT}"         # Đỏ Coral Neon
  fi

  REPLY="${temp_color}${temp_icon} ${C_DATA}${temp}°C"
}

function zsh_temp_info_compact() {
  REPLY=""
  zsh_get_temp
  local temp=$REPLY
  if [[ -z "$temp" || "$temp" -eq 0 ]]; then
    REPLY=""
    return
  fi

  local temp_icon="$I_TEMP_COLD"
  local temp_color="${C_ACCENT}"

  if (( temp < 45 )); then
    temp_icon="$I_TEMP_COLD"
    temp_color="${C_ACCENT}"
  elif (( temp < 60 )); then
    temp_icon="$I_TEMP_WARM"
    temp_color="%F{#8CC84B}"
  elif (( temp < 75 )); then
    temp_icon="$I_TEMP_HOT"
    temp_color="%F{#FFD43B}"
  else
    temp_icon="$I_TEMP_CRIT"
    temp_color="${C_ALERT}"
  fi

  # Phiên bản compact: chỉ hiển thị icon đổi màu dựa trên nhiệt độ
  REPLY="${temp_color}${temp_icon}"
}

# Tự động nhận diện và lưu đường dẫn file thông tin Pin/AC nguồn (Tối ưu hóa tránh quét đĩa khi render)
_BAT_CAPACITY_FILE=""
_BAT_STATUS_FILE=""
_AC_ONLINE_FILE=""
function () {
  local bat_dirs=(/sys/class/power_supply/BAT*(N))
  if [[ ${#bat_dirs} -gt 0 ]]; then
    _BAT_CAPACITY_FILE="${bat_dirs[1]}/capacity"
    _BAT_STATUS_FILE="${bat_dirs[1]}/status"
  fi
  local ac_dirs=(/sys/class/power_supply/AC*(N) /sys/class/power_supply/ADP*(N))
