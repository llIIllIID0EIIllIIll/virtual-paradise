    # Auto-rebuild uvx cache if binary is newer than cache file
    if [[ ! -f "$UVX_COMP_FILE" || ( -n "$UVX_BIN" && "$UVX_BIN" -nt "$UVX_COMP_FILE" ) ]]; then
      mkdir -p "$(dirname "$UVX_COMP_FILE")"
      uvx --generate-shell-completion zsh >| "$UVX_COMP_FILE" 2>/dev/null
    fi
    [[ -f "$UVX_COMP_FILE" ]] && source "$UVX_COMP_FILE"
  fi
fi

