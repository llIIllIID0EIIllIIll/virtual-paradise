# --- KHỞI CHẠY DAEMON CẬP NHẬT WIFI & NHIỆT ĐỘ ĐỘC LẬP (Tối ưu hóa 0ms trễ Prompt) ---
# Cơ chế: Khởi chạy 1 tiến trình nền chạy tuần hoàn mỗi 5 giây để lấy trạng thái mạng.
# Riêng việc lấy nhiệt độ CPU/GPU (sử dụng nvidia-smi chậm ~1.1s trên WSL) được gọi mỗi 30 giây.
# Cách làm này tách hoàn toàn các tiến trình chậm ra khỏi luồng xử lý chính của Prompt.
function () {
  local pid_file="${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_wifi_daemon.pid"
  local daemon_pid=""
  [[ -f "$pid_file" ]] && daemon_pid=$(<"$pid_file")
  if [[ -z "$daemon_pid" ]] || ! kill -0 "$daemon_pid" 2>/dev/null; then
    (
      mkdir -p "${ZSH_CACHE_DIR:-$HOME/.cache}"
      local temp_counter=0
      while true; do
        # 1. Cập nhật thông tin Wi-Fi
        if (( $+commands[netsh.exe] )); then
          netsh.exe wlan show interfaces < /dev/null >| "${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_wifi_raw" 2>/dev/null
        elif (( $+commands[iwgetid] )); then
          local ssid=$(iwgetid -r 2>/dev/null)
          local signal=""
          if [[ -n "$ssid" && -f /proc/net/wireless ]]; then
            signal=$(awk 'NR==3 {print $3}' /proc/net/wireless 2>/dev/null | tr -d '.')
          fi
          echo "$ssid|$signal||" >| "${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_wifi_status"
        elif (( $+commands[nmcli] )); then
          local active_wifi=$(nmcli -t -f active,ssid,signal dev wifi 2>/dev/null | grep '^yes:')
          local ssid="" signal=""
          if [[ -n "$active_wifi" ]]; then
            ssid=$(echo "$active_wifi" | cut -d':' -f2)
            signal=$(echo "$active_wifi" | cut -d':' -f3)
          fi
          echo "$ssid|$signal||" >| "${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_wifi_status"
        fi

        # 2. Cập nhật thông tin Nhiệt độ (mỗi 30 giây để tránh tốn tài nguyên của nvidia-smi)
        if (( temp_counter % 6 == 0 )); then
          local temp=0
          local f
          for f in /sys/class/thermal/thermal_zone*/temp(N); do
            local val=$(<$f)
            if [[ -n "$val" && "$val" -gt 0 ]]; then
              if (( val > 1000 )); then temp=$(( val / 1000 )); else temp=$val; fi
              break
            fi
          done
          if [[ $temp -eq 0 ]]; then
            for f in /sys/class/hwmon/hwmon*/temp*_input(N); do
              local val=$(<$f)
              if [[ -n "$val" && "$val" -gt 0 ]]; then
                if (( val > 1000 )); then temp=$(( val / 1000 )); else temp=$val; fi
                break
              fi
            done
          fi
          if [[ $temp -eq 0 ]] && (( $+commands[nvidia-smi] )); then
            local val=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null)
            if [[ -n "$val" && "$val" =~ ^[0-9]+$ ]]; then
              temp=$val
            fi
          fi
          echo "$temp" >| "${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_temp_status"
        fi

        (( temp_counter++ ))
        sleep 5
      done
    ) >/dev/null 2>&1 &!
    echo $! >| "$pid_file"
  fi
}

# I. Module tổng hợp thông tin góc trên bên phải (R_TOP Info)
# Ghép nối các module thông tin hệ thống (RAM/Swap, Pin) thành một chuỗi duy nhất
# với ký tự phân tách 󰫣 giữa các phần, sau đó đóng khung bằng ký tự ─╮ (R_TOP).
function zsh_top_right_info() {
  local parts=()  # Mảng chứa các phần thông tin đã render
  
  # Thu thập thông tin RAM (đọc trực tiếp cực nhanh ~0.07ms)
  zsh_mem_info
  if [[ -n "$REPLY" ]]; then
    parts+=("$REPLY")
  fi
  
  # Thu thập thông tin nhiệt độ CPU/GPU (đọc trực tiếp cực nhanh ~0.08ms)
  zsh_temp_info
  if [[ -n "$REPLY" ]]; then
    parts+=("$REPLY")
  fi
  
  # Thu thập thông tin Wi-Fi (đọc trực tiếp từ file cache ~0.1ms)
  zsh_wifi_info
  if [[ -n "$REPLY" ]]; then
    parts+=("$REPLY")
  fi
  
  # Thu thập thông tin Pin (đọc trực tiếp cực nhanh ~0.08ms)
  zsh_battery_info
  if [[ -n "$REPLY" ]]; then
    parts+=("$REPLY")
  fi
  
  # Ghép các phần lại bằng ký tự phân tách 󰫣 (chỉ thêm phân tách giữa các phần, không thêm ở đầu)
  local joined=""
  local i
  for ((i=1; i<=${#parts}; i++)); do
    if [[ $i -gt 1 ]]; then
      joined+="${C_DIM}${I_SEP} "
    fi
    joined+="${parts[i]}"
  done
  
  # Xuất kết quả kèm ký tự đóng khung ─╮ ở cuối. Nếu có nội dung thì thêm 1 khoảng trắng ở đầu để cách khỏi phần trái.
  if [[ -n "$joined" ]]; then
    REPLY=" ${joined}${C_DIM}${R_TOP}${C_RESET}"
  else
    REPLY="${C_DIM}${R_TOP}${C_RESET}"
  fi
}

# Compact variants used when terminal is narrow: show icons with percents only (or icon-only for battery)
function zsh_mem_info_compact() {
  REPLY=""
  local meminfo
  if [[ -f /proc/meminfo ]]; then
    meminfo=$(</proc/meminfo)
    local total avail
    if [[ "$meminfo" =~ $'[[:space:]]*MemTotal:[[:space:]]*([0-9]+)' ]]; then
      total=$match[1]
    fi
    if [[ "$meminfo" =~ $'[[:space:]]*MemAvailable:[[:space:]]*([0-9]+)' ]]; then
      avail=$match[1]
    fi

    if [[ -n $total && -n $avail ]]; then
      local used=$(( total - avail ))
      local mem_pct=$(( (used * 100) / total ))
      
      local ram_icon="$I_RAM_LOW"
      local ram_color="${C_ACCENT}"
      
      if (( mem_pct < 50 )); then
        ram_icon="$I_RAM_LOW"
        ram_color="${C_ACCENT}"
      elif (( mem_pct < 80 )); then
        ram_icon="$I_RAM_MID"
        ram_color="%F{#FFD43B}"
      else
        ram_icon="$I_RAM_HIGH"
        ram_color="${C_ALERT}"
      fi

      REPLY="${ram_color}${ram_icon}"
    fi
  fi
}

function zsh_battery_info_compact() {
  REPLY=""
  if [[ -n "$_BAT_CAPACITY_FILE" && -f "$_BAT_CAPACITY_FILE" ]]; then
    local capacity=$(<"$_BAT_CAPACITY_FILE")
    local bat_status=$(<"$_BAT_STATUS_FILE")
    local bat_icon="󰁹"
    local bat_color="${C_ACCENT}"
    
    # Kiểm tra cắm sạc qua AC (online) cho compact mode
    local ac_online=0
    if [[ -n "$_AC_ONLINE_FILE" && -f "$_AC_ONLINE_FILE" ]]; then
      ac_online=$(<"$_AC_ONLINE_FILE")
    fi

      if [[ "$bat_status" == "Charging" || "$ac_online" == "1" ]]; then
        bat_color="%F{#8CC84B}"
        if [[ $capacity -ge 95 ]]; then bat_icon="$I_BAT_CHARGING_100"
        elif [[ $capacity -ge 90 ]]; then bat_icon="$I_BAT_CHARGING_90"
        elif [[ $capacity -ge 80 ]]; then bat_icon="$I_BAT_CHARGING_80"
        elif [[ $capacity -ge 70 ]]; then bat_icon="$I_BAT_CHARGING_70"
        elif [[ $capacity -ge 60 ]]; then bat_icon="$I_BAT_CHARGING_60"
        elif [[ $capacity -ge 50 ]]; then bat_icon="$I_BAT_CHARGING_50"
        elif [[ $capacity -ge 40 ]]; then bat_icon="$I_BAT_CHARGING_40"
        elif [[ $capacity -ge 30 ]]; then bat_icon="$I_BAT_CHARGING_30"
        elif [[ $capacity -ge 20 ]]; then bat_icon="$I_BAT_CHARGING_20"
        else bat_icon="$I_BAT_CHARGING_0"
        fi
      else
        if (( capacity <= 10 )); then
          bat_color="${C_ALERT}"
        fi
        if [[ $capacity -ge 95 ]]; then bat_icon="$I_BAT_100"
        elif [[ $capacity -ge 90 ]]; then bat_icon="$I_BAT_90"
        elif [[ $capacity -ge 80 ]]; then bat_icon="$I_BAT_80"
        elif [[ $capacity -ge 70 ]]; then bat_icon="$I_BAT_70"
        elif [[ $capacity -ge 60 ]]; then bat_icon="$I_BAT_60"
        elif [[ $capacity -ge 50 ]]; then bat_icon="$I_BAT_50"
        elif [[ $capacity -ge 40 ]]; then bat_icon="$I_BAT_40"
        elif [[ $capacity -ge 30 ]]; then bat_icon="$I_BAT_30"
        elif [[ $capacity -ge 20 ]]; then bat_icon="$I_BAT_20"
        else bat_icon="$I_BAT_0"
        fi
      fi
      REPLY="${bat_color}${bat_icon}${C_RESET}"
  fi
}

function zsh_top_right_compact_info() {
  local parts=()
  # Đọc trực tiếp các giá trị thời gian thực cực nhanh (RAM, Temp, Wi-Fi, Pin)
