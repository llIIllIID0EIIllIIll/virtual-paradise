# History configuration and optimizations
HISTSIZE=50000                 # Maximum commands stored in current session memory
SAVEHIST=50000                 # Maximum commands saved persistently to ~/.zsh_history
setopt APPEND_HISTORY          # Append history immediately after execution rather than waiting for shell exit
setopt SHARE_HISTORY           # Share command history across all open terminal windows/sessions in real-time
setopt HIST_IGNORE_ALL_DUPS    # Remove older duplicates and preserve newest entry in history
setopt HIST_REDUCE_BLANKS      # Trim unnecessary whitespace from history commands
setopt HIST_IGNORE_SPACE       # Ignore commands starting with a space to prevent logging sensitive secrets/passwords
setopt HIST_VERIFY             # Verify history expansion (e.g. !!, !$) before executing

# Disable AT-SPI bridge to speed up GUI app launch from terminal and suppress accessibility warnings
export NO_AT_BRIDGE=1

# Input method environment variables (Fcitx / IBus) for GUI applications:
export GTK_IM_MODULE=fcitx     # GTK input module configuration
export QT_IM_MODULE=fcitx      # Qt input module configuration
export XMODIFIERS=@im=fcitx    # X11 input method configuration

# --- Keybinding Fixes: Home, End, Delete, Ctrl+Arrows ---
# Ensure terminal key sequences map accurately across all emulators
# Bind standard physical keycodes to Zsh Line Editor (ZLE) functions
bindkey '^[[H' beginning-of-line      # Home: Move cursor to beginning of line
bindkey '^[[F' end-of-line            # End: Move cursor to end of line
bindkey '^[[3~' delete-char           # Delete: Delete character under cursor
bindkey '^[[1;5C' forward-word        # Ctrl + Right: Forward one word
bindkey '^[[1;5D' backward-word       # Ctrl + Left: Backward one word
bindkey '^H' backward-kill-word      # Ctrl + Backspace: Delete backward word

