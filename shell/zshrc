# --- BACKGROUND DAEMON: Asynchronous Network & Thermal Monitoring (0ms Prompt Latency) ---
# Runs an independent background loop polling Wi-Fi every 5s and thermals every 30s.
# Completely decouples slow telemetry syscalls from prompt rendering.
# Guarantees zero hesitation or lag when pressing Enter.
function () {
  local pid_file="${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_wifi_daemon.pid"
  local daemon_pid=""
  [[ -f "$pid_file" ]] && daemon_pid=$(<"$pid_file")
  if [[ -z "$daemon_pid" ]] || ! kill -0 "$daemon_pid" 2>/dev/null; then
    (
      mkdir -p "${ZSH_CACHE_DIR:-$HOME/.cache}"
      local temp_counter=0
      while true; do
        # 1. Poll Wi-Fi connection info
        if (( $+commands[netsh.exe] )); then
          netsh.exe wlan show interfaces < /dev/null >| "${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_wifi_raw" 2>/dev/null
        elif (( $+commands[iwgetid] )); then
          local ssid=$(iwgetid -r 2>/dev/null)
          local signal=""
          if [[ -n "$ssid" && -f /proc/net/wireless ]]; then
            signal=$(awk 'NR==3 {print $3}' /proc/net/wireless 2>/dev/null | tr -d '.')
          fi
          echo "$ssid|$signal||" >| "${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_wifi_status"
        elif (( $+commands[nmcli] )); then
          local active_wifi=$(nmcli -t -f active,ssid,signal dev wifi 2>/dev/null | grep '^yes:')
          local ssid="" signal=""
          if [[ -n "$active_wifi" ]]; then
            ssid=$(echo "$active_wifi" | cut -d':' -f2)
            signal=$(echo "$active_wifi" | cut -d':' -f3)
          fi
          echo "$ssid|$signal||" >| "${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_wifi_status"
        fi

        # 2. Poll CPU/GPU thermals (every 30s to conserve GPU resources)
        if (( temp_counter % 6 == 0 )); then
          local temp=0
          local f
          for f in /sys/class/thermal/thermal_zone*/temp(N); do
            local val=$(<$f)
            if [[ -n "$val" && "$val" -gt 0 ]]; then
              if (( val > 1000 )); then temp=$(( val / 1000 )); else temp=$val; fi
              break
            fi
          done
          if [[ $temp -eq 0 ]]; then
            for f in /sys/class/hwmon/hwmon*/temp*_input(N); do
              local val=$(<$f)
              if [[ -n "$val" && "$val" -gt 0 ]]; then
                if (( val > 1000 )); then temp=$(( val / 1000 )); else temp=$val; fi
                break
              fi
            done
          fi
          if [[ $temp -eq 0 ]] && (( $+commands[nvidia-smi] )); then
            local val=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null)
            if [[ -n "$val" && "$val" =~ ^[0-9]+$ ]]; then
              temp=$val
            fi
          fi
          echo "$temp" >| "${ZSH_CACHE_DIR:-$HOME/.cache}/wsl_temp_status"
        fi

        (( temp_counter++ ))
        sleep 5
      done
    ) >/dev/null 2>&1 &!
    echo $! >| "$pid_file"
  fi
}

# Module I: Top-Right System Telemetry HUD (R_TOP)
