  local right_expanded="${(%)right_line}"
  local left_clean="${left_expanded//${esc}\[[0-9;]#[a-zA-Z]/}"
  local right_clean="${right_expanded//${esc}\[[0-9;]#[a-zA-Z]/}"
  
  # Compensates for double-width Nerd Font glyphs counted as 1 column by Zsh
  local w_left=0
  local w_right=0
  if [[ "$ZSH_HUD_NERD_MONO" != "true" ]]; then
    local left_clean_no_wide="${left_clean//[${ZSH_HUD_WIDE_CHARS}]/}"
    w_left=$(( ${#left_clean} - ${#left_clean_no_wide} ))
    
    local right_clean_no_wide="${right_clean//[${ZSH_HUD_WIDE_CHARS}]/}"
    w_right=$(( ${#right_clean} - ${#right_clean_no_wide} ))
  fi
  local left_len=$(( ${#left_clean} + w_left ))
  local right_len=$(( ${#right_clean} + w_right ))
  
  # Temporarily suppresses R_TOP during active window resize to prevent buffer tearing
  # Ensures clean single-line display during Hyprland tiling adjustments
  if [[ "$_RESIZE_ACTIVE" == "1" ]]; then
