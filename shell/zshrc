    if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
      local -a short_pills
      [[ -n "$os_seg" ]] && short_pills+=("$os_seg")
      [[ -n "$user_info" ]] && short_pills+=("$user_info")
      short_left="${C_DIM}${L_TOP} ${(j: :)short_pills}"
    else
      local c_dim_escaped="${C_DIM//\#/\\#}"
      local sep_pattern="[[:space:]]#${c_dim_escaped}${I_SEP}[[:space:]]#"
      short_left="${left_line%%$~sep_pattern}"
    fi
    
    local short_left_expanded="${(%)short_left}"
    local short_left_clean="${short_left_expanded//${esc}\[[0-9;]#[a-zA-Z]/}"
    
    local w_short_left=0
    if [[ "$ZSH_HUD_NERD_MONO" != "true" ]]; then
      local short_left_clean_no_wide="${short_left_clean//[${ZSH_HUD_WIDE_CHARS}]/}"
      w_short_left=$(( ${#short_left_clean} - ${#short_left_clean_no_wide} ))
    fi
    
    local short_left_inflation=""
    if (( w_short_left > 0 )); then
      short_left_inflation="${(l:w_short_left:: :)}%{${esc}[${w_short_left}D%}"
    fi
    echo -n "${short_left}${short_left_inflation}"
    return
  fi
  
  # Responsive threshold check: automatically drops or collapses R_TOP if terminal is too narrow
  # Strictly prevents cursor wrapping to the next line
  if (( COLUMNS < left_len + right_len + 2 )); then
    local short_left
    if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
      local -a short_pills
      [[ -n "$os_seg" ]] && short_pills+=("$os_seg")
      [[ -n "$user_info" ]] && short_pills+=("$user_info")
      [[ -n "$dir_info" ]] && short_pills+=("$dir_info")
      short_left="${C_DIM}${L_TOP} ${(j: :)short_pills}"
    else
      local c_dim_escaped="${C_DIM//\#/\\#}"
      local sep_pattern="[[:space:]]#${c_dim_escaped}${I_SEP}[[:space:]]#"
      short_left="${left_line%%$~sep_pattern}"
    fi
 
    # Try rendering compact right HUD block
    local compact_right
    zsh_top_right_compact_info
    compact_right="$REPLY"
 
    local short_left_expanded="${(%)short_left}"
    local short_left_clean="${short_left_expanded//${esc}\[[0-9;]#[a-zA-Z]/}"
    local compact_expanded="${(%)compact_right}"
    local compact_clean="${compact_expanded//${esc}\[[0-9;]#[a-zA-Z]/}"
 
    local w_short_left=0
    local w_compact=0
    if [[ "$ZSH_HUD_NERD_MONO" != "true" ]]; then
      local short_left_clean_no_wide="${short_left_clean//[${ZSH_HUD_WIDE_CHARS}]/}"
      w_short_left=$(( ${#short_left_clean} - ${#short_left_clean_no_wide} ))
      local compact_clean_no_wide="${compact_clean//[${ZSH_HUD_WIDE_CHARS}]/}"
      w_compact=$(( ${#compact_clean} - ${#compact_clean_no_wide} ))
    fi
 
    local short_left_len=$(( ${#short_left_clean} + w_short_left ))
    local compact_len=$(( ${#compact_clean} + w_compact ))
 
    local indent=${ZLE_RPROMPT_INDENT:-1}
    local right_start=$(( COLUMNS - compact_len + 1 - indent ))
    if (( COLUMNS >= short_left_len + compact_len + 2 && right_start > short_left_len + 1 )); then
      echo -n "${short_left}%{${esc}[${right_start}G%}${compact_right}"
    else
      echo -n "${short_left}"
    fi
  else
    # Applies Cursor Horizontal Absolute (\e[...G) with mathematical boundary guards
    local indent=${ZLE_RPROMPT_INDENT:-1}
    local right_start=$(( COLUMNS - right_len + 1 - indent ))
    if (( right_start > left_len + 1 && right_start + right_len <= COLUMNS + 1 )); then
      echo -n "${left_line}%{${esc}[${right_start}G%}${right_line}"
    else
      echo -n "${left_line}"
    fi
  fi
}
# Signal handler for instant prompt reflow on window resize (SIGWINCH)
# TRAPWINCH executes automatically on terminal geometry change
# Debounce architecture: buffers continuous SIGWINCH events during window drag
# Hides R_TOP and triggers 0.15s timer before graceful restoration
# Resets debounce timer if new resize event occurs within window
# Sends SIGUSR1 to main shell process upon resize completion
TRAPWINCH() {
  # Suppresses job monitor logs for background timers
  # local_options: scoped strictly to this handler
  setopt local_options no_monitor
  
  # Sets active resize flag
  _RESIZE_ACTIVE=1
  # [[ -o zle ]]: Ensure ZLE is active (prevents redraw errors during active execution)
  # zle reset-prompt: Requests immediate ZLE prompt redraw
  if [[ -o zle ]]; then
    zle reset-prompt 2>/dev/null
  fi
  
  # Cancels previous debounce timer if still active
  if [[ -n $_RESIZE_TIMER_PID ]] && kill -0 $_RESIZE_TIMER_PID 2>/dev/null; then
    kill $_RESIZE_TIMER_PID 2>/dev/null
  fi
  
  # Cancels previous delay timer if still active
  if [[ -n $_RESIZE_DELAY_PID ]] && kill -0 $_RESIZE_DELAY_PID 2>/dev/null; then
    kill $_RESIZE_DELAY_PID 2>/dev/null
  fi
  
  # Spawns 0.15s background timer to signal SIGUSR1
  # &! (disown): Disown background timer immediately from job table
  # Suppresses job start and completion logs from polluting terminal
  (
    sleep 0.15
    kill -USR1 $$ 2>/dev/null
  ) &!
  _RESIZE_TIMER_PID=$!  # Store timer PID to cancel on subsequent SIGWINCH
}

# Signal handler triggered when window drag stops (SIGUSR1)
# TRAPUSR1: Triggered when shell receives SIGUSR1 from debounce timer.
# Initiates recovery delay timer before restoring R_TOP.
TRAPUSR1() {
  setopt local_options no_monitor
  # 0.15s stabilization delay after window resize finishes
  (
    sleep 0.15
    kill -USR2 $$ 2>/dev/null
  ) &!
  _RESIZE_DELAY_PID=$!
}

# Signal handler triggered when delay expires (SIGUSR2)
# TRAPUSR2: Triggered when shell receives SIGUSR2 from recovery delay timer.
# Disables resize flag and redraws complete prompt at new column width
TRAPUSR2() {
  _RESIZE_ACTIVE=0  # Reset resize flag: restores full R_TOP HUD
  if [[ -o zle ]]; then
    zle reset-prompt 2>/dev/null  # Redraw prompt with R_TOP aligned to new COLUMNS
  fi
}

# Module H3: Analog Clock Icon Selector
# Selects corresponding analog clock icon based on current 12-hour cycle
function zsh_time_icon() {
  local hour=$(strftime "%I" $EPOCHSECONDS)
  hour=$(( 10#$hour ))
  local -a clocks
  clocks=(
    "$I_TIME_12" "$I_TIME_1" "$I_TIME_2" "$I_TIME_3" "$I_TIME_4" "$I_TIME_5"
    "$I_TIME_6" "$I_TIME_7" "$I_TIME_8" "$I_TIME_9" "$I_TIME_10" "$I_TIME_11"
  )
  local idx=$(( hour % 12 ))
  echo -n "${clocks[idx + 1]}"
}

