# Compact variants used when terminal is narrow: show icons with percents only (or icon-only for battery)
function zsh_mem_info_compact() {
  REPLY=""
  local meminfo
  if [[ -f /proc/meminfo ]]; then
    meminfo=$(</proc/meminfo)
    local total avail
    if [[ "$meminfo" =~ $'[[:space:]]*MemTotal:[[:space:]]*([0-9]+)' ]]; then
      total=$match[1]
    fi
    if [[ "$meminfo" =~ $'[[:space:]]*MemAvailable:[[:space:]]*([0-9]+)' ]]; then
      avail=$match[1]
    fi

    if [[ -n $total && -n $avail ]]; then
      local used=$(( total - avail ))
      local mem_pct=$(( (used * 100) / total ))
      
      local ram_icon="$I_RAM_LOW"
      local ram_color="${C_ACCENT}"
      
      if (( mem_pct < 50 )); then
        ram_icon="$I_RAM_LOW"
        ram_color="${C_ACCENT}"
      elif (( mem_pct < 80 )); then
        ram_icon="$I_RAM_MID"
        ram_color="%F{#FFD43B}"
      else
        ram_icon="$I_RAM_HIGH"
        ram_color="${C_ALERT}"
      fi

      REPLY="${ram_color}${ram_icon}"
    fi
  fi
}

