# J. Hàm tạo dòng thứ nhất của Prompt động để căn lề phải responsive
function zsh_top_line() {
  setopt localoptions extendedglob
  zsh_init_caps # Khởi tạo hình dáng capsule động
  
  # Sử dụng các giá trị đã cache
  local user_info="$_CACHE_USER_INFO"
  local dir_info="$_CACHE_DIR_INFO"
  local git_status="$_CACHE_GIT_STATUS"
  local tool_context="$_CACHE_TOOL_CONTEXT"
  local REPLY
  zsh_top_right_info
  local top_right="$REPLY"
  
  # Ghép chuỗi dòng bên trái và bên phải
  local left_line
  local os_seg=""
  if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
    local os_bg_start="#00FFDD"
    local os_bg_end="#00ADD8"
    local os_fg="#11111b"
    
    case "${ZSH_HUD_OS_ID:-linux}" in
      ubuntu)
        os_bg_start="#E95420"
        os_bg_end="#77216F"
        os_fg="#ffffff"
        ;;
      debian)
        os_bg_start="#D70A53"
        os_bg_end="#A80030"
        os_fg="#ffffff"
        ;;
      arch)
        os_bg_start="#00f5d4"
        os_bg_end="#00ff88"
        os_fg="#11111b"
        ;;
      fedora)
        os_bg_start="#3C6EB4"
        os_bg_end="#5180C7"
        os_fg="#ffffff"
        ;;
      centos)
        os_bg_start="#262577"
        os_bg_end="#7f2b7b"
        os_fg="#ffffff"
        ;;
      alpine)
        os_bg_start="#0D597F"
        os_bg_end="#3572A5"
        os_fg="#ffffff"
        ;;
      darwin)
        os_bg_start="#7d7d7d"
        os_bg_end="#d6d6d6"
        os_fg="#11111b"
        ;;
      windows)
        os_bg_start="#0078D4"
        os_bg_end="#00bcf2"
        os_fg="#ffffff"
        ;;
      *) # linux fallback
        os_bg_start="#ffcc00"
        os_bg_end="#ff9900"
        os_fg="#11111b"
        ;;
    esac
    
    local os_content="$I_OS"
    if [[ -n "$ZSH_HUD_OS_NAME" ]]; then
      os_content="${I_OS} ${ZSH_HUD_OS_NAME}"
    fi
    
    zsh_make_gradient_pill "$os_bg_start" "$os_bg_end" "$os_fg" "$os_content"
    os_seg="$REPLY"
    local -a pills
    [[ -n "$os_seg" ]] && pills+=("$os_seg")
    [[ -n "$user_info" ]] && pills+=("$user_info")
    [[ -n "$dir_info" ]] && pills+=("$dir_info")
    [[ -n "$git_status" ]] && pills+=("$git_status")
    [[ -n "$tool_context" ]] && pills+=("$tool_context")
    left_line="${C_DIM}${L_TOP} ${(j: :)pills}"
  else
    left_line="${C_DIM}${L_TOP}${C_ACCENT}${I_OS} ${C_DIM}${I_SEP} ${user_info}${dir_info}${git_status}${tool_context}"
  fi
  local right_line="${top_right}"
  
  # Tính toán độ dài ký tự hiển thị thực tế (bỏ qua toàn bộ mã màu ANSI)
  local esc=$'\e'
  local left_expanded="${(%)left_line}"
  local right_expanded="${(%)right_line}"
  local left_clean="${left_expanded//${esc}\[[0-9;]#[a-zA-Z]/}"
  local right_clean="${right_expanded//${esc}\[[0-9;]#[a-zA-Z]/}"
  
  # Bù chiều rộng cho các icon Nerd Font hiển thị double-width nhưng Zsh đếm là 1.
  local w_left=0
  local w_right=0
  if [[ "$ZSH_HUD_NERD_MONO" != "true" ]]; then
    local left_clean_no_wide="${left_clean//[${ZSH_HUD_WIDE_CHARS}]/}"
    w_left=$(( ${#left_clean} - ${#left_clean_no_wide} ))
    
    local right_clean_no_wide="${right_clean//[${ZSH_HUD_WIDE_CHARS}]/}"
    w_right=$(( ${#right_clean} - ${#right_clean_no_wide} ))
  fi
  local left_len=$(( ${#left_clean} + w_left ))
  local right_len=$(( ${#right_clean} + w_right ))
  
  # Nếu đang trong quá trình kéo giãn/thu nhỏ, ẩn hoàn toàn khối bên phải R_TOP
  # để tránh giật lag và vỡ dòng. Chỉ giữ lại khối bên trái sạch sẽ.
  if [[ "$_RESIZE_ACTIVE" == "1" ]]; then
    local short_left
    if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
      local -a short_pills
      [[ -n "$os_seg" ]] && short_pills+=("$os_seg")
      [[ -n "$user_info" ]] && short_pills+=("$user_info")
      short_left="${C_DIM}${L_TOP} ${(j: :)short_pills}"
    else
      local c_dim_escaped="${C_DIM//\#/\\#}"
      local sep_pattern="[[:space:]]#${c_dim_escaped}${I_SEP}[[:space:]]#"
      short_left="${left_line%%$~sep_pattern}"
    fi
    
    local short_left_expanded="${(%)short_left}"
    local short_left_clean="${short_left_expanded//${esc}\[[0-9;]#[a-zA-Z]/}"
    
    local w_short_left=0
    if [[ "$ZSH_HUD_NERD_MONO" != "true" ]]; then
      local short_left_clean_no_wide="${short_left_clean//[${ZSH_HUD_WIDE_CHARS}]/}"
      w_short_left=$(( ${#short_left_clean} - ${#short_left_clean_no_wide} ))
    fi
    
    local short_left_inflation=""
    if (( w_short_left > 0 )); then
      short_left_inflation="${(l:w_short_left:: :)}%{${esc}[${w_short_left}D%}"
    fi
    echo -n "${short_left}${short_left_inflation}"
    return
  fi
  
  # Nếu cửa sổ terminal quá nhỏ không đủ chứa cả hai khối (cộng thêm 2 ký tự an toàn),
  # tự động ẩn khối bên phải hoặc chuyển sang compact mode để ngăn tràn dòng tuyệt đối.
  if (( COLUMNS < left_len + right_len + 2 )); then
    local short_left
    if [[ "$ZSH_PROMPT_STYLE" == "powerline" ]]; then
      local -a short_pills
      [[ -n "$os_seg" ]] && short_pills+=("$os_seg")
      [[ -n "$user_info" ]] && short_pills+=("$user_info")
      [[ -n "$dir_info" ]] && short_pills+=("$dir_info")
      short_left="${C_DIM}${L_TOP} ${(j: :)short_pills}"
    else
      local c_dim_escaped="${C_DIM//\#/\\#}"
      local sep_pattern="[[:space:]]#${c_dim_escaped}${I_SEP}[[:space:]]#"
      short_left="${left_line%%$~sep_pattern}"
    fi
 
    # Thử hiển thị khối rút gọn bên phải (Compact Mode)
    local compact_right
    zsh_top_right_compact_info
    compact_right="$REPLY"
 
    local short_left_expanded="${(%)short_left}"
    local short_left_clean="${short_left_expanded//${esc}\[[0-9;]#[a-zA-Z]/}"
    local compact_expanded="${(%)compact_right}"
    local compact_clean="${compact_expanded//${esc}\[[0-9;]#[a-zA-Z]/}"
 
    local w_short_left=0
    local w_compact=0
    if [[ "$ZSH_HUD_NERD_MONO" != "true" ]]; then
      local short_left_clean_no_wide="${short_left_clean//[${ZSH_HUD_WIDE_CHARS}]/}"
      w_short_left=$(( ${#short_left_clean} - ${#short_left_clean_no_wide} ))
      local compact_clean_no_wide="${compact_clean//[${ZSH_HUD_WIDE_CHARS}]/}"
      w_compact=$(( ${#compact_clean} - ${#compact_clean_no_wide} ))
    fi
 
    local short_left_len=$(( ${#short_left_clean} + w_short_left ))
    local compact_len=$(( ${#compact_clean} + w_compact ))
 
    local indent=${ZLE_RPROMPT_INDENT:-1}
    local right_start=$(( COLUMNS - compact_len + 1 - indent ))
    if (( COLUMNS >= short_left_len + compact_len + 2 && right_start > short_left_len + 1 )); then
      echo -n "${short_left}%{${esc}[${right_start}G%}${compact_right}"
    else
      echo -n "${short_left}"
    fi
  else
    # Căn lề phải an toàn bằng mã vị trí con trỏ ngang tuyệt đối (Cursor Horizontal Absolute).
    local indent=${ZLE_RPROMPT_INDENT:-1}
    local right_start=$(( COLUMNS - right_len + 1 - indent ))
    if (( right_start > left_len + 1 && right_start + right_len <= COLUMNS + 1 )); then
      echo -n "${left_line}%{${esc}[${right_start}G%}${right_line}"
    else
      echo -n "${left_line}"
    fi
  fi
}
# Signal handler để vẽ lại prompt tức thì khi co giãn cửa sổ.
# TRAPWINCH được Zsh tự động gọi mỗi khi nhận tín hiệu SIGWINCH (kích thước cửa sổ Terminal thay đổi).
# Cơ chế debounce: Khi người dùng kéo mép cửa sổ liên tục, SIGWINCH bắn hàng chục lần/giây.
# Ta ẩn R_TOP ngay lập tức để prompt nhẹ và không vỡ dòng, đồng thời đặt một timer 0.15 giây.
# Nếu có resize mới trong 0.15s, timer cũ bị hủy và tạo timer mới. Khi dừng kéo quá 0.15s,
# timer gửi SIGUSR1 về shell chính → TRAPUSR1 khôi phục R_TOP với chiều rộng mới.
TRAPWINCH() {
  # Tắt giám sát job cục bộ (no_monitor) để Zsh không in thông báo PID, terminated, done của tiến trình ngầm
  # local_options: chỉ áp dụng trong phạm vi hàm này, không ảnh hưởng đến shell chính
  setopt local_options no_monitor
  
  # Bật cờ resize: zsh_top_line() sẽ kiểm tra cờ này để quyết định ẩn R_TOP
  _RESIZE_ACTIVE=1
  # [[ -o zle ]]: Kiểm tra Zsh Line Editor đang hoạt động (tránh lỗi khi resize xảy ra lúc đang chạy lệnh)
  # zle reset-prompt: Yêu cầu ZLE vẽ lại prompt ngay lập tức (lúc này R_TOP bị ẩn do _RESIZE_ACTIVE=1)
  if [[ -o zle ]]; then
    zle reset-prompt 2>/dev/null
  fi
  
  # Hủy timer debounce cũ nếu vẫn đang chạy (kill -0 kiểm tra tiến trình còn sống không)
  if [[ -n $_RESIZE_TIMER_PID ]] && kill -0 $_RESIZE_TIMER_PID 2>/dev/null; then
    kill $_RESIZE_TIMER_PID 2>/dev/null
  fi
  
  # Hủy timer delay phục hồi cũ nếu vẫn đang chạy
  if [[ -n $_RESIZE_DELAY_PID ]] && kill -0 $_RESIZE_DELAY_PID 2>/dev/null; then
    kill $_RESIZE_DELAY_PID 2>/dev/null
  fi
  
  # Tạo timer debounce mới: chạy ngầm 0.15 giây rồi gửi tín hiệu SIGUSR1 về shell chính ($$).
  # &! (disown): Giải phóng tiến trình khỏi bảng quản lý job của Zsh ngay khi sinh ra,
  # ngăn chặn hoàn toàn việc Zsh in thông báo "[1] PID" khi bắt đầu và "terminated/done" khi kết thúc.
  (
    sleep 0.15
    kill -USR1 $$ 2>/dev/null
  ) &!
  _RESIZE_TIMER_PID=$!  # Lưu PID của timer mới để có thể hủy nếu nhận SIGWINCH tiếp theo
}

# Signal handler xử lý khi người dùng đã dừng kéo cửa sổ (nhận tín hiệu SIGUSR1 từ timer debounce).
# TRAPUSR1 được Zsh tự động gọi khi shell nhận tín hiệu SIGUSR1 (tín hiệu người dùng tùy chỉnh số 1).
# Tại đây, ta bắt đầu bộ đếm thời gian delay trước khi chính thức hiển thị lại R_TOP.
TRAPUSR1() {
  setopt local_options no_monitor
  # Đợi thêm 0.15 giây sau khi kéo xong để giao diện terminal ổn định hoàn toàn trước khi vẽ lại
  (
    sleep 0.15
    kill -USR2 $$ 2>/dev/null
  ) &!
  _RESIZE_DELAY_PID=$!
}

# Signal handler xử lý khi hết thời gian trì hoãn vẽ lại (nhận tín hiệu SIGUSR2 từ delay timer).
# TRAPUSR2 được Zsh tự động gọi khi shell nhận tín hiệu SIGUSR2 (tín hiệu người dùng tùy chỉnh số 2).
# Tại đây ta chính thức tắt cờ resize và vẽ lại prompt đầy đủ với R_TOP hiện ra ở vị trí mới.
TRAPUSR2() {
  _RESIZE_ACTIVE=0  # Tắt cờ resize: zsh_top_line() sẽ hiển thị lại R_TOP đầy đủ
  if [[ -o zle ]]; then
    zle reset-prompt 2>/dev/null  # Vẽ lại prompt hoàn chỉnh với R_TOP căn lề phải theo COLUMNS mới
  fi
}

# H3. Module hiển thị icon thời gian động (Time Icon)
# Lấy biểu tượng đồng hồ tương ứng với giờ hiện tại (12 mức tương ứng từ 1h - 12h)
function zsh_time_icon() {
  local hour=$(strftime "%I" $EPOCHSECONDS)
  hour=$(( 10#$hour ))
  local -a clocks
  clocks=(
    "$I_TIME_12" "$I_TIME_1" "$I_TIME_2" "$I_TIME_3" "$I_TIME_4" "$I_TIME_5"
    "$I_TIME_6" "$I_TIME_7" "$I_TIME_8" "$I_TIME_9" "$I_TIME_10" "$I_TIME_11"
  )
  local idx=$(( hour % 12 ))
  echo -n "${clocks[idx + 1]}"
}

