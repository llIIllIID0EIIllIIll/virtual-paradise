# [1] mkcd: Create directory and cd into it immediately.
# -> Usage: mkcd <directory_path>
# -> Example: mkcd src/components/auth
function mkcd() {
  # Validate directory argument
  if [ -z "$1" ]; then
    # Print warning if directory name is missing
    print -P "%F{yellow}[WARN]%f Error: Directory name required! (Usage: mkcd <directory_name>)"
    return 1 # Return error code 1
  fi
  # mkdir -p: Create parent directory hierarchy
  # && cd: Enter directory on success
  mkdir -p "$1" && cd "$1"
}

# [2] extract: Universal archive extractor supporting all major formats.
# -> Usage: extract <archive_file>
# -> Example: extract archive.tar.gz
function extract() {
  # Verify target archive exists
  if [ -f "$1" ] ; then
    # Match file extension and execute corresponding extractor
    case "$1" in
      *.tar.bz2)   tar xjf "$1"     ;; # Extract .tar.bz2 archive
      *.tar.gz)    tar xzf "$1"     ;; # Extract .tar.gz archive
      *.tar.xz|*.txz) tar -xJf "$1" ;; # Extract .tar.xz archive
      *.tar.zst|*.tar.zstd) tar --zstd -xf "$1" ;; # Extract .tar.zst archive
      *.bz2)       bunzip2 "$1"     ;; # Extract .bz2 archive
      *.rar)       unrar x "$1"     ;; # Extract .rar archive (requires unrar)
      *.gz)        gunzip "$1"      ;; # Extract .gz archive
      *.tar)       tar xf "$1"      ;; # Extract .tar tarball
      *.tbz2)      tar xjf "$1"     ;; # Extract .tbz2 archive
      *.tgz)       tar xzf "$1"     ;; # Extract .tgz archive
      *.zip)       unzip "$1"       ;; # Extract .zip archive (requires unzip)
      *.Z)         uncompress "$1"  ;; # Extract classic .Z archive
      *.7z)        7z x "$1"        ;; # Extract .7z archive (requires p7zip)
      *)           # Print red warning for unsupported format
                   print -P "%F{red}[ERROR]%f Error: '$1' format is not supported by extract()" ;;
    esac
  else
    # Print error if file path does not exist
    print -P "%F{red}[ERROR]%f Error: '$1' is not a valid file or does not exist!"
  fi
}

# [3] weather: Query live terminal weather forecast via wttr.in.
# -> Usage: weather [city_name] (defaults to current location)
# -> Example: weather Tokyo
function weather() {
  # Assign city argument; defaults to local if empty
  local city="${1:-}"
  # Send GET request to wttr.in with metric units (?m)
  # 5-second timeout to avoid terminal hang
  curl -sS --max-time 5 "https://wttr.in/${city}?m"
}

# [4] myip: Query public IP address (WAN).
# -> Usage: myip
function myip() {
  # Silently query ifconfig.me for public IP
  # && echo "": Print newline after IP query
  # 5-second timeout to avoid terminal hang
  curl -sS --max-time 5 https://ifconfig.me && echo ""
}

# [5] portkill: Free network port by terminating listening process.
# -> Usage: portkill <port_number>
# -> Example: portkill 3000
function portkill() {
  # Check if port number was provided
  if [ -z "$1" ]; then
    print -P "%F{yellow}[WARN]%f Error: Port number required! (Usage: portkill <port_number>)"
    return 1
  fi
  # Query PID listening on port
  local pid=$(lsof -t -i:"$1")
  if [ -n "$pid" ]; then
    print -P "%F{blue}[INFO]%f Requesting termination (SIGTERM) for PID $pid on port $1..."
    kill $pid 2>/dev/null
    
    # Wait 0.5s to verify termination
    sleep 0.5
    if kill -0 $pid 2>/dev/null; then
      print -P "%F{yellow}[WARN]%f Process did not stop. Force killing (SIGKILL)..."
      kill -9 $pid 2>/dev/null
    fi
    print -P "%F{green}[OK]%f Successfully freed port $1."
  else
    print -P "%F{blue}[INFO]%f No active process found listening on port $1."
  fi
}

# [6] glog: Search Git commit log by keyword.
# -> Usage: glog "<query>"
# -> Example: glog "fix auth"
function glog() {
  # Validate search query parameter
  if [ -z "$1" ]; then
    print -P "%F{yellow}[WARN]%f Error: Search term required! (Usage: glog \"search query\")"
    return 1
  fi
  # Verify inside Git repository
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    print -P "%F{red}[ERROR]%f Error: Current directory is not a Git repository!"
    return 1
  fi
  # git log --all: Search across all branches
  # --grep="$1": Filter commits matching query
  # --oneline: One-line concise format (hash + message)
  git log --all --grep="$1" --oneline
}

# [7] server: Instant static HTTP server for local web development.
# -> Usage: server [port] (defaults to 8000)
# -> Example: server 9000
function server() {
  # Assign port argument or default to 8000
  local port="${1:-8000}"
  
  # Option 1: Use Python 3 http.server module
  if (( $+commands[python3] )); then
    print -P "%F{green}[OK]%f HTTP Server started (Python 3) at: http://localhost:$port"
    python3 -m http.server "$port"
    
  # Option 2: Fallback to Python 2 SimpleHTTPServer
  elif (( $+commands[python] )); then
    print -P "%F{green}[OK]%f HTTP Server started (Python) at: http://localhost:$port"
    python -m SimpleHTTPServer "$port"
    
  # Option 3: Fallback to Node.js http-server
  elif (( $+commands[pnpm] )); then
    print -P "%F{green}[OK]%f HTTP Server started (Node http-server) at: http://localhost:$port"
    pnpm dlx http-server -p "$port"
    
  # Error if neither Python nor Node is installed
  else
    print -P "%F{red}[ERROR]%f Error: Neither Python nor Node is installed to start a server."
    return 1
  fi
}

# [8] backup: Create safe backup copy of target file or folder.
# -> Usage: backup <file_or_directory>
# -> Example: backup config.json (creates config.bak)
function backup() {
  # Validate target parameter
  if [ -z "$1" ]; then
    print -P "%F{yellow}[WARN]%f Error: Target file or directory path required!"
    return 1
  fi
  
  local filename="$1"
  # Replace extension with .bak
  local backup_name="${filename%.*}.bak"
  
  # Format folder backup name as <dirname>_bak
  if [ -d "$filename" ]; then
    backup_name="${filename}_bak"
  fi
  
  # cp -r: Copy recursively preserving folder contents
  cp -r "$filename" "$backup_name"
  print -P "%F{green}[OK]%f Backup created successfully: '$filename' -> '$backup_name'"
}

# [9] mkfile: Create new file with automatic parent directories.
# -> Usage: mkfile <path>
# -> Example: mkfile app/components/modals/LoginModal.tsx
function mkfile() {
  # Validate target file path
  if [ -z "$1" ]; then
    print -P "%F{yellow}[WARN]%f Error: File path required!"
    return 1
  fi
  # Extract parent directory path
  # mkdir -p: Create parent directories if missing
  # && touch "$1": Create empty file inside directory
  mkdir -p "$(dirname "$1")" && touch "$1"
}

# [10] dirsize: List sizes of files and subfolders in current directory sorted descending.
# -> Usage: dirsize
function dirsize() {
  print -P "%F{blue}[INFO]%f Calculating directory and file sizes..."
  # du -sh *: Measure human-readable size of all items in current dir
  # Use 'command du' to bypass aliases
  # 2>/dev/null: Suppress permission errors on system files
  # sort -hr: Sort sizes in descending order
  command du -sh * 2>/dev/null | sort -hr
}

