# =========================================================================
# ⚙️ OH MY ZSH CORE CONFIGURATION
# =========================================================================

# Path to Oh My Zsh installation directory (defaults to ~/.oh-my-zsh)
export ZSH="$HOME/.oh-my-zsh"

# Declare terminal type to support full 256-color palette (optimized for modern TUIs)
export TERM=xterm-256color

# Standard LS_COLORS configuration for file and folder highlighting. 
# ow: other-writable directory (green bg, black text)
# tw: sticky and other-writable directory
# st: sticky directory without other-write permissions
# di: standard directory (blue)
# fi: regular file (default white)
export LS_COLORS="ow=01;30;44:tw=01;30;44:st=01;30;44:di=01;34:fi=0"

# Set default system editor for git and terminal sessions
# When editor is invoked (e.g. git commit), terminal waits for editor close
export EDITOR="code --wait"

# Set default system pager for reading long text and manpages
export PAGER="less"

# Optimized flags for 'less' pager:
# -F: Automatically exit if text fits on a single screen
# -g: Highlight only the last matching search result
# -i: Case-insensitive search unless search pattern contains uppercase
# -M: Verbose prompt showing line position and percentage
# -R: Output raw ANSI color sequences properly (preserves log colors)
# -S: Chop long lines to prevent line wrapping and preserve tabular formatting
# -w: Highlight first line on page-down to keep reading context
# -X: Keep content in scrollback buffer on exit
# -z-4: Retain 4 lines of overlap when scrolling
export LESS="-F -g -i -M -R -S -w -X -z-4"

# Disable default theme loading (custom HUD prompt implemented below)
ZSH_THEME=""

# Disable auto-setting terminal title to optimize startup performance
DISABLE_AUTO_TITLE="true"

# Optimize Git prompt performance on large repositories
DISABLE_UNTRACKED_FILES_DIRTY="true"

# Only run heavy initialization on first startup (optimizes 'src' reload down to <5ms)
if [[ -z "$_ZSHRC_INITIALIZED" ]]; then
  # Add zsh-completions fpath before sourcing Oh My Zsh
  fpath+=("${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src")

  # List of Oh My Zsh and custom third-party plugins to load on startup
  plugins=(
    git                       # Git shortcuts, completions, and status integration
    zsh-completions           # Additional tab-completion definitions for hundreds of CLI tools
    zsh-autosuggestions       # Fish-like autosuggestions based on command history
    zsh-syntax-highlighting   # Real-time command syntax highlighting (green=valid, red=invalid)
  )

  # Load core Oh My Zsh startup script
  source $ZSH/oh-my-zsh.sh

  # Dynamic Syntax Highlighting color configuration
  typeset -A ZSH_HIGHLIGHT_STYLES
  ZSH_HIGHLIGHT_STYLES[command]='fg=#00ff88,bold'               # Valid command: Hacker Green
  ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#ff0055,bold'          # Unknown / invalid command: Neon Warning Red
  ZSH_HIGHLIGHT_STYLES[alias]='fg=#00f5d4,bold'                  # Command Alias: Miku Cyan
  ZSH_HIGHLIGHT_STYLES[builtin]='fg=#ffb7d5,bold'                # Shell builtin command: Sakura Pink
  ZSH_HIGHLIGHT_STYLES[function]='fg=#00f5d4,bold'               # Shell function: Miku Cyan
  ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#7091a4'            # Command separators (&&, ;, |): Muted Slate
  ZSH_HIGHLIGHT_STYLES[path]='fg=#00f5d4,underline'              # File / directory paths: Underlined Cyan
  ZSH_HIGHLIGHT_STYLES[path_prefix]='fg=#00f5d4'
  ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#ffe066'      # Single-quoted string: Cyber Yellow
  ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#ffe066'      # Double-quoted string: Cyber Yellow
  ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg=#ffb7d5' # Environment variables ($VAR): Sakura Pink
  ZSH_HIGHLIGHT_STYLES[back-quoted-argument]='fg=#ffb7d5'        # Back-quoted command substitution: Sakura Pink
  ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#39c5bb'        # Short options / flags (-a, -f): Cyan Blue
  ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#39c5bb'        # Long options / flags (--help): Cyan Blue
  ZSH_HIGHLIGHT_STYLES[cursor]='bg=#00f5d4'

  # Autosuggestion styling
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#7091a4"
fi

