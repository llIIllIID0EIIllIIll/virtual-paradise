# Smart autocompletion matcher list:
# 'm:{a-zA-Z}={A-Za-z}': Case-insensitive completion (e.g. 'doc' matches 'Documents')
# 'r:|[._-]=* r:|=*': Substring & abbreviation completion (e.g. 'a_b' matches 'apple_banana')
# 'l:|=* r:|=*': Mid-word matching completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# Interactive Tab-completion selection menu (navigate with arrow keys):
